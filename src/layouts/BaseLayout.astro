---
import "../assets/global.css";
import "../assets/panel-styles.css";
import Footer from "./Footer.astro";
import { ClientRouter } from "astro:transitions";

const { pathname } = Astro.url;
const siteName = "Algorithmic Art Gallery";
const siteUrl = "https://art.jonathanrreed.com";
const socialImageUrl = `${siteUrl}/icon.png`;
const {
  title = "Algorithmic Art Gallery | Jonathan R. Reed",
  description = "Create generative artworks with algorithmic growth systems, curated controls, and high-resolution export tools by Jonathan R. Reed.",
  structuredData = [],
} = Astro.props;
const normalizedPathname =
  pathname === "/" || pathname.endsWith("/") ? pathname : `${pathname}/`;
const canonicalUrl = `${siteUrl}${normalizedPathname}`;
const isActivePath = (path: string) => normalizedPathname === path;
const pageStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const schemaGraph = [
  {
    "@type": "Person",
    "@id": "https://jonathanrreed.com/#person",
    name: "Jonathan R. Reed",
    alternateName: ["Jonathan Reed", "Jonathan Reed AI"],
    url: "https://jonathanrreed.com/",
    sameAs: [
      "https://github.com/JonathanRReed",
      "https://helloworldfirm.com/",
      "https://www.linkedin.com/in/jonathanrreed0/",
    ],
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: siteName,
    url: `${siteUrl}/`,
    description,
    author: {
      "@id": "https://jonathanrreed.com/#person",
    },
    publisher: {
      "@id": "https://jonathanrreed.com/#person",
    },
    inLanguage: "en-US",
  },
  {
    "@type": "WebApplication",
    "@id": `${siteUrl}/#app`,
    name: "Algorithmic Art Gallery",
    url: `${siteUrl}/`,
    applicationCategory: "DesignApplication",
    operatingSystem: "Web Browser",
    description:
      "Browser-based generative art studio for deterministic space-filling curve artwork, saved gallery studies, and high-resolution exports.",
    creator: {
      "@id": "https://jonathanrreed.com/#person",
    },
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
    review: {
      "@type": "Review",
      author: {
        "@id": "https://jonathanrreed.com/#person",
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: 5,
        bestRating: 5,
        worstRating: 1,
      },
      reviewBody:
        "A free browser-based generative art studio for creating deterministic space-filling curve artwork, reviewing saved studies, and exporting high-resolution pieces.",
    },
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    isPartOf: {
      "@id": `${siteUrl}/#website`,
    },
    author: {
      "@id": "https://jonathanrreed.com/#person",
    },
    datePublished: "2026-04-21",
    dateModified: "2026-04-21",
    inLanguage: "en-US",
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Jonathan R. Reed" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" id="theme-color-meta" content="#e7e1d3" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="article:author" content="Jonathan R. Reed" />
    <meta property="article:published_time" content="2026-04-21T00:00:00-05:00" />
    <meta property="article:modified_time" content="2026-04-21T00:00:00-05:00" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Drafting Studio fonts: Fraunces (display) · Archivo (text) · IBM Plex Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <link
      rel="manifest"
      href="/manifest.json"
      crossorigin="use-credentials"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": schemaGraph,
      })}
    />
    {
      pageStructuredData.filter(Boolean).map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            ...schema,
          })}
        />
      ))
    }

    <script is:inline>
      (function () {
        try {
          const localTheme = localStorage.getItem("theme");
          const isDark =
            localTheme === "dark" ||
            (!localTheme &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (isDark) {
            document.documentElement.classList.add("dark-theme");
          }
          const meta = document.getElementById("theme-color-meta");
          if (meta) meta.setAttribute("content", isDark ? "#14130d" : "#e7e1d3");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-background"></div>
    <div
      id="route-announcer"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
      transition:persist
    ></div>

    <header class="site-header" aria-label="Primary">
      <nav class="nav-container">
        <a class="site-logo" href="/">
          <svg class="logo-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M3 3h6v6H3V3Zm0 12h6v6H3v-6Zm12 0h6v6h-6v-6Zm0-12h6v6h-6V3ZM6 9v6m12-6v6M9 6h6m-6 12h6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
            />
          </svg>
          <span class="site-logo-text">Algorithmic<span class="site-logo-accent">Art Gallery</span></span>
          <span class="sr-only"> home</span>
        </a>
        <div class="main-nav">
          <a class={isActivePath("/") ? "nav-link active" : "nav-link"} href="/">Generator</a>
          <a class={isActivePath("/gallery/") ? "nav-link active" : "nav-link"} href="/gallery/">Gallery</a>
          <a class={isActivePath("/about/") ? "nav-link active" : "nav-link"} href="/about/">About</a>
          <a class={isActivePath("/contact/") ? "nav-link active" : "nav-link"} href="/contact/">Contact</a>
          <button
            id="theme-toggle"
            class="theme-toggle-btn"
            type="button"
            aria-label="Toggle light and dark theme"
            aria-pressed="false"
            title="Toggle theme"
          >
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.5" />
              <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main-content" class="content-wrapper" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (function () {
        // Guard: the inline script may be re-evaluated on a view-transition
        // swap - only register the page-load handler once.
        if (window.__aagInit) return;
        window.__aagInit = true;

        function initPage() {
          // Scroll-triggered reveals (re-run for each navigated page)
          const fadeElements = Array.from(document.querySelectorAll("[data-reveal]"));
          const revealAll = () =>
            fadeElements.forEach((el) => el.classList.add("reveal-visible"));

          if ("IntersectionObserver" in window) {
            const io = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("reveal-visible");
                  io.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1, rootMargin: "0px 0px -10% 0px" });
            fadeElements.forEach((el) => {
              el.classList.add("reveal-element");
              io.observe(el);
            });
            // Safety net: content must never stay hidden if the observer
            // never fires (background tab, headless render, edge cases).
            setTimeout(revealAll, 1200);
          } else {
            revealAll();
          }

          // Keep the active nav link in sync after client-side navigation
          const path =
            location.pathname === "/" || location.pathname.endsWith("/")
              ? location.pathname
              : location.pathname + "/";
          document.querySelectorAll(".nav-link").forEach((link) => {
            const href = link.getAttribute("href");
            link.classList.toggle("active", href === path);
          });

          // Theme toggle (button is re-rendered on each navigation)
          const themeBtn = document.getElementById("theme-toggle");
          if (themeBtn) {
            const meta = document.getElementById("theme-color-meta");
            const sync = (isDark) => {
              themeBtn.setAttribute("aria-pressed", String(isDark));
              if (meta) meta.setAttribute("content", isDark ? "#14130d" : "#e7e1d3");
            };
            sync(document.documentElement.classList.contains("dark-theme"));
            themeBtn.addEventListener("click", () => {
              const isDark = document.documentElement.classList.toggle("dark-theme");
              try {
                localStorage.setItem("theme", isDark ? "dark" : "light");
              } catch (e) {}
              sync(isDark);
            });
          }
        }

        // Delegated click ripple - registered once on the persistent document
        document.addEventListener("click", (e) => {
          const target = e.target.closest(
            'button, [role="button"], .nav-link, .site-logo, .gallery-action-btn',
          );
          if (target) {
            target.classList.add("click-effect");
            setTimeout(() => target.classList.remove("click-effect"), 150);
          }
        });

        // astro:page-load fires on first load AND after every view transition
        document.addEventListener("astro:page-load", initPage);

        // After a client-side navigation, move focus to the new page's main
        // region and announce the new title (View Transitions otherwise drop
        // focus to <body> with no announcement). Fires only on transitions.
        document.addEventListener("astro:after-swap", () => {
          // A view-transition swap restores the server-rendered <html>, which has
          // no theme class - re-apply the saved/system theme before paint so it
          // doesn't snap back to light on every navigation.
          try {
            const localTheme = localStorage.getItem("theme");
            const isDark =
              localTheme === "dark" ||
              (!localTheme &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.classList.toggle("dark-theme", isDark);
            const meta = document.getElementById("theme-color-meta");
            if (meta) meta.setAttribute("content", isDark ? "#14130d" : "#e7e1d3");
          } catch (e) {}

          const main = document.getElementById("main-content");
          if (main) main.focus({ preventScroll: true });
          const announcer = document.getElementById("route-announcer");
          if (announcer) announcer.textContent = document.title;
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .content-wrapper {
    min-height: 70vh;
    width: 100%;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow-x: hidden;
    padding-bottom: 3rem;
  }

  /* ---- Instrument-bar header ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid var(--rule);
  }

  .nav-container {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding: 0 var(--gutter);
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0;
  }

  .logo-mark {
    width: 22px;
    height: 22px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .site-logo-text {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1.05;
    display: inline-flex;
    flex-direction: column;
  }

  .site-logo-accent {
    color: var(--ink-2);
    font-weight: 500;
  }

  .site-logo:hover .site-logo-accent {
    color: var(--accent);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--ink-2);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    padding: 0.55rem 0.7rem;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.3rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--ink);
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-left: 0.35rem;
    padding: 0;
    background: transparent;
    border: var(--surface-border);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast),
      background var(--transition-fast);
  }

  .theme-toggle-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-icon {
    width: 18px;
    height: 18px;
  }

  .theme-icon-moon { display: none; }
  .dark-theme .theme-icon-sun { display: none; }
  .dark-theme .theme-icon-moon { display: block; }

  .click-effect {
    transform: translateY(1px);
  }

  @media (max-width: 720px) {
    .nav-container {
      flex-wrap: wrap;
      padding: 0.5rem var(--gutter);
      gap: 0.5rem 0.75rem;
    }
    .main-nav {
      width: 100%;
      order: 2;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      border-top: 1px solid var(--line);
      padding-top: 0.4rem;
    }
    .nav-link {
      white-space: nowrap;
    }
    .theme-toggle-btn {
      margin-left: auto;
    }
  }
</style>
