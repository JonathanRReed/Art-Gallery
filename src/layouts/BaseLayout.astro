---
import "../assets/global.css";
import "../assets/panel-styles.css";
import Footer from "./Footer.astro";

const { pathname } = Astro.url;
const siteName = "Algorithmic Art Gallery";
const siteUrl = "https://art.jonathanrreed.com";
const socialImageUrl = `${siteUrl}/icon.png`;
const {
  title = "Algorithmic Art Gallery | Jonathan R Reed",
  description = "Create generative artworks with algorithmic growth systems, curated controls, and high-resolution export tools by Jonathan R Reed.",
} = Astro.props;
const canonicalUrl = `${siteUrl}${pathname}`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f7f8fc" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Editorial Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="manifest"
      href="/manifest.json"
      crossorigin="use-credentials"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteName,
        url: siteUrl,
        description: description,
        author: {
          "@type": "Person",
          name: "Jonathan Reed",
        },
      })}
    />

    <script is:inline>
      (function () {
        try {
          const localTheme = localStorage.getItem("theme");
          if (
            localTheme === "dark" ||
            (!localTheme &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark-theme");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page-background"></div>

    <div class="content-wrapper">
      <slot />
    </div>

    <Footer />

    <script is:inline defer>
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px",
        };
        const fadeInObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("reveal-visible");
            }
          });
        }, observerOptions);

        const fadeElements = document.querySelectorAll(
          ".intro-section, .panel-container, .preview-container, .gallery-card, .footer-section, .art-grid, .art-block",
        );
        fadeElements.forEach((el) => {
          el.classList.add("reveal-element");
          fadeInObserver.observe(el);
        });

        document.body.addEventListener("click", (e) => {
          const target = e.target.closest(
            'button, [role="button"], .nav-link, .site-logo, .gallery-action-btn',
          );
          if (target) {
            target.classList.add("click-effect");
            setTimeout(() => target.classList.remove("click-effect"), 150);
          }
        });

        const themeBtn = document.getElementById("theme-toggle");
        if (themeBtn) {
          themeBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark-theme");
            const isDark = document.documentElement.classList.contains("dark-theme");
            try {
              localStorage.setItem("theme", isDark ? "dark" : "light");
            } catch (e) {}
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .content-wrapper {
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow-x: hidden;
    padding-top: 1rem;
    padding-bottom: 2.5rem;
  }

  .site-header {
    display: none;
  }

  .nav-container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    min-height: 3.5rem;
  }

	.site-logo {
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 1.1rem;
		text-decoration: none;
		letter-spacing: 0.05em;
		display: flex;
		align-items: center;
		padding: 0 2rem;
		border-right: var(--border-ink);
		background-color: var(--color-paper);
	}

	.site-logo:hover {
		background-color: var(--color-ink);
		color: var(--color-paper);
	}

	.main-nav {
		display: flex;
		gap: 0;
	}

	.nav-link {
		color: var(--color-ink);
		text-decoration: none;
		display: flex;
		align-items: center;
		padding: 0 1.5rem;
		border-left: var(--border-ink);
		transition:
			background-color 0s,
			color 0s;
	}

	.nav-link:hover,
	.nav-link.active {
		background-color: var(--color-ink);
		color: var(--color-paper);
	}

	.click-effect {
		filter: invert(1);
	}

	/* Paper noise texture */
	.page-background::after {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0.018;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='4' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
		z-index: 9999;
		mix-blend-mode: multiply;
	}

	/* Stark reveals */
	.reveal-element {
		opacity: 0;
		clip-path: inset(100% 0 0 0);
		transform: translateY(10px);
		transition:
			opacity 0.6s cubic-bezier(0.2, 0, 0, 1),
			clip-path 0.8s cubic-bezier(0.2, 0, 0, 1),
			transform 0.8s cubic-bezier(0.2, 0, 0, 1);
	}

	.reveal-visible {
		opacity: 1;
		clip-path: inset(0 0 0 0);
		transform: translateY(0);
	}

	a,
	button {
		transition: none; /* Brutalist snap */
	}

	.theme-toggle-btn {
		background: transparent;
		border: none;
		font-family: inherit;
		font-size: inherit;
		cursor: pointer;
		display: flex;
		align-items: center;
		padding: 0 1.5rem;
		border-left: var(--border-ink);
	}

	button:focus-visible,
	a:focus-visible,
	input:focus-visible,
	select:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-element {
			opacity: 1;
			clip-path: none;
			transform: none;
			transition: none;
		}
	}

	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
		}
		.site-logo {
			border-right: none;
			border-bottom: var(--border-ink);
			justify-content: center;
			padding: 0.75rem;
		}
		.main-nav {
			width: 100%;
			overflow-x: auto;
		}
		.nav-link {
			border-left: none;
			border-right: var(--border-ink);
			padding: 0.75rem 1rem;
			white-space: nowrap;
		}
		.content-wrapper {
			padding-top: 0.75rem;
		}
	}
</style>
