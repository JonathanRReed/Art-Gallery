---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-branding">
        <span class="footer-product-main"
          >Algorithmic <span class="footer-product-company">Art Gallery</span
          ></span
        >
        <span class="footer-product-author">by Jonathan Reed</span>
      </div>

      <div class="footer-links">
        <a href="/" class="footer-link">
          <span>Generator</span>
        </a>
        <a href="/gallery/" class="footer-link">
          <span>Gallery</span>
        </a>
        <a href="/about/" class="footer-link">
          <span>About</span>
        </a>
        <a href="/privacy/" class="footer-link">
          <span>Privacy</span>
        </a>
        <a href="/contact/" class="footer-link">
          <span>Contact</span>
        </a>
        <a
          href="https://JonathanRReed.com/"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Jonathan Reed's Portfolio"
        >
          <img
            src="/jonathan.avif"
            alt="Jonathan Reed"
            width="24"
            height="24"
            class="footer-icon-img"
          />
          <span>Portfolio</span>
        </a>
        <a
          href="https://helloworldfirm.com/"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Hello World Consulting"
        >
          <img
            src="/Logo.avif"
            alt="Hello World Consulting"
            width="24"
            height="24"
            class="footer-icon-img"
          />
          <span>HWC</span>
        </a>
        <a
          href="https://zentype.jonathanrreed.com/"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          title="ZenType Typing Trainer"
        >
          <svg
            class="footer-icon-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path
              d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"
            ></path>
          </svg>
          <span>ZenType</span>
        </a>
        <a
          href="https://jonathanrreed.com/projects/"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
          title="More projects by Jonathan R Reed"
        >
          <svg
            class="footer-icon-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"
            ></path>
            <path
              d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
            ></path>
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
          </svg>
          <span>Projects</span>
        </a>
      </div>

      <button class="share-button" id="shareButton" title="Share this website" type="button">
        <svg
          class="share-icon-svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span class="share-text" id="shareButtonText">Share</span>
      </button>
    </div>
    <div class="footer-copyright">{year} &copy; Jonathan R Reed · All rights reserved</div>
  </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    const shareButton = document.getElementById("shareButton");
    const shareButtonText = document.getElementById("shareButtonText");

    if (!shareButton || !shareButtonText) return;

    const resetShareLabel = () => {
      window.setTimeout(() => {
        shareButtonText.textContent = "Share";
      }, 1800);
    };

    shareButton.addEventListener("click", async () => {
      const shareData = {
        title: "Algorithmic Art Gallery",
        text: "Explore this algorithmic art generator and create your own variation.",
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
          shareButtonText.textContent = "Shared";
          resetShareLabel();
          return;
        } catch (err) {
          if (err instanceof Error && err.name === "AbortError") {
            return;
          }
        }
      }

      try {
        await navigator.clipboard.writeText(window.location.href);
        shareButtonText.textContent = "Link copied";
      } catch (err) {
        shareButtonText.textContent = "Copy link manually";
      }

      resetShareLabel();
    });
  });
</script>

<style>
  .site-footer {
    width: 100%;
    padding: 1rem 0 1.5rem;
    margin-top: var(--section-gap);
  }

  /* The footer is ONE sheet: the container holds the surface, the main row and
     the copyright line share it, divided by a hairline - not two floating bands. */
  .footer-container {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    box-sizing: border-box;
  }

  .footer-main {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    background: var(--paper);
    border: var(--surface-border);
    border-bottom: 0;
    padding: 1.1rem var(--pad-panel);
  }

  .footer-branding {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer-product-main {
    font-family: var(--font-mono);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .footer-product-company {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .footer-product-author {
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 400;
  }

  .footer-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-2);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.6rem;
    border: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--ink);
    background-color: var(--paper-2);
    border-color: var(--line-strong);
  }

  .footer-icon-img {
    width: 22px;
    height: 22px;
    border-radius: 0;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter var(--transition-fast);
  }

  .footer-link:hover .footer-icon-img {
    filter: grayscale(0);
  }

  .footer-icon-svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }

  .footer-link:hover .footer-icon-svg {
    opacity: 1;
  }

  .share-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .share-button:hover {
    background-color: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .share-icon-svg {
    width: 15px;
    height: 15px;
  }

  .footer-copyright {
    text-align: center;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    /* bottom row of the same footer sheet, divided by a hairline */
    background: var(--paper);
    border: var(--surface-border);
    border-top: 1px solid var(--line);
    padding: 0.75rem var(--pad-panel);
  }

  @media (max-width: 768px) {
    .footer-container {
      padding-inline: var(--gutter);
    }

    .footer-main {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }

    .footer-branding {
      align-items: center;
    }

    .footer-links {
      justify-content: center;
    }
  }
</style>
