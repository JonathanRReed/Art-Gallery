---
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutVideoSchema = {
  "@type": "VideoObject",
  "@id": "https://art.jonathanrreed.com/about/#corridor-video",
  name: "I Made Art That HACKS Your Eyes",
  description:
    "Reference video that inspired the Algorithmic Art Gallery exploration of generated visual systems and perception-driven artwork.",
  thumbnailUrl: "https://i.ytimg.com/vi/SxsN6FRXMWQ/hqdefault.jpg",
  embedUrl: "https://www.youtube.com/embed/SxsN6FRXMWQ",
  uploadDate: "2024-01-01",
  publisher: {
    "@type": "Organization",
    name: "Corridor Crew",
  },
};
---

<BaseLayout
  title="Generative Art Process | Jonathan R Reed"
  description="Learn how the Algorithmic Art Gallery by Jonathan R Reed creates generative art using space-filling curves and mathematical algorithms."
  structuredData={[aboutVideoSchema]}
>
  <div class="about-page">
    <!-- Header -->
    <header class="about-hero reveal-element">
      <p class="mono-text about-eyebrow">Process</p>
      <h1 class="about-header">About</h1>
      <p class="mono-text about-meta">
        By Jonathan R Reed. Updated <time datetime="2026-04-21">April 21, 2026</time>.
      </p>
    </header>

    <div class="about-content">
      <!-- The Project -->
      <section class="about-section reveal-element">
        <div class="section-pill">
          <span class="mono-text">01</span>
        </div>
        <h2 class="about-subheader">The Project</h2>
        <div class="about-card">
          <p>
            This is a small generative art project by me, Jonathan Reed! It uses
            space-filling curves (Hilbert and Morton) combined with color mapping
            to produce patterns. You control the seed value, growth mode,
            symmetry, and color ordering, then let the algorithm fill in the
            pixels.
          </p>
          <p>
            Every output is deterministic: same settings produce the same image.
            Change a parameter and you get something new. It's mostly an
            experiment in seeing what happens when you let math do the drawing.
          </p>
          <p>
            The project is also a practical study in creative tooling. The generator
            keeps the controls visible, the output repeatable, and the saved gallery
            close to the work surface so each image can be treated as a small
            experiment rather than a disposable random effect.
          </p>
        </div>
        <p class="about-link">
          <a
            href="https://jonathanrreed.com/projects/"
            target="_blank"
            rel="noopener noreferrer"
          >
            See more projects by Jonathan Reed →
          </a>
        </p>
      </section>

      <!-- Technology & Video -->
      <section class="about-section reveal-element">
        <div class="section-pill">
          <span class="mono-text">02</span>
        </div>
        <h2 class="about-subheader">The Technology</h2>
        <div class="about-card">
          <p>
            Built with Astro and React, this application uses modern web
            technologies to provide a fast, responsive experience. An interface
            inspired by a frosted-glass aesthetic, featuring a dark mode theme
            with warm coral accents that complements the vibrant colors of the
            generated art.
          </p>
        </div>

        <div class="video-frame reveal-element">
          <p class="mono-text video-eyebrow">Reference</p>
          <h3 class="video-title">I Made Art That HACKS Your Eyes</h3>
          <div class="video-container">
            <iframe
              width="560"
              height="315"
              src="https://www.youtube.com/embed/SxsN6FRXMWQ?si=p4sz9KDZs15OeUoL"
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            >
            </iframe>
          </div>
          <p class="video-caption">
            The video is included as a reference point for the visual idea, but the
            generator itself is built around browser-side controls, deterministic
            settings, and exportable studies that can be recreated from documented
            parameters.
          </p>
        </div>
      </section>

      <!-- How It Works -->
      <section class="about-section reveal-element">
        <div class="section-pill">
          <span class="mono-text">03</span>
        </div>
        <h2 class="about-subheader">How It Works</h2>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number mono-text">1</div>
            <h3>Select Parameters</h3>
            <ul class="parameter-list">
              <li>
                <strong>Seed & Growth</strong>: Control the seed value, pattern
                size, growth mode, seed shape, and more
              </li>
              <li>
                <strong>Color & Symmetry</strong>: Define color progression, curve
                type, color ordering, and symmetry options
              </li>
            </ul>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">2</div>
            <h3>Generate</h3>
            <p>
              Our algorithm processes your parameters to create a unique piece of algorithmic art.
            </p>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">3</div>
            <h3>Export</h3>
            <p>
              Download your creation as a PNG or PDF file.
            </p>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">4</div>
            <h3>Save</h3>
            <p>
              Add your favorite generations to your personal gallery to revisit later.
            </p>
          </div>
        </div>
      </section>

      <!-- Pattern Generation Options -->
      <section class="about-section reveal-element">
        <div class="section-pill">
          <span class="mono-text">04</span>
        </div>
        <h2 class="about-subheader">Pattern Generation Options</h2>
        <p class="feature-intro">
          Click on any option below to learn more about it:
        </p>
        <div class="feature-grid">
          <div class="feature-item" data-feature="growth-modes">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Growth Modes</h3>
                <p class="feature-summary">Crystal, Nebula, Rings</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Crystal:</strong> Creates crystalline formations with angular
                  structures, growing in a more geometric pattern.
                </li>
                <li>
                  <strong>Nebula:</strong> Produces cloud-like, organic shapes with
                  diffused edges that resemble cosmic nebulae.
                </li>
                <li>
                  <strong>Rings:</strong> Generates concentric circles and orbital
                  patterns that expand outward like ripples.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="seed-shapes">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Seed Shapes</h3>
                <p class="feature-summary">Point, Circle, Line</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Point:</strong> Starts growth from a single point at the
                  center, creating a radial expansion pattern.
                </li>
                <li>
                  <strong>Circle:</strong> Begins with a circular boundary that expands
                  outward, creating ring-like structures.
                </li>
                <li>
                  <strong>Line:</strong> Initiates growth from a line across the center,
                  creating mirror-like patterns.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="symmetry">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Symmetry</h3>
                <p class="feature-summary">None, Bilateral, Quadrantal, Radial</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>None:</strong> No symmetry applied - pattern grows freely
                  in all directions without mirroring.
                </li>
                <li>
                  <strong>Bilateral:</strong> Mirror symmetry along a central axis,
                  like a butterfly's wings.
                </li>
                <li>
                  <strong>Quadrantal:</strong> Four-way symmetry, mirrored in four
                  quadrants from the center.
                </li>
                <li>
                  <strong>Radial:</strong> Circular symmetry, repeating pattern radiates
                  from the center point.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="color-progression">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Color Progression</h3>
                <p class="feature-summary">Sequential, Shuffled, Base Distance</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Sequential:</strong> Colors follow a strict sequence based
                  on their position in the RGB space.
                </li>
                <li>
                  <strong>Shuffled:</strong> Colors are randomly arranged while maintaining
                  visual coherence.
                </li>
                <li>
                  <strong>Base Distance:</strong> Colors are distributed based on
                  their distance from a base color.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="curve-types">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Curve Types</h3>
                <p class="feature-summary">Hilbert, Morton</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Hilbert:</strong> A space-filling curve that preserves locality
                  well, creating smoother color transitions and more organic patterns.
                </li>
                <li>
                  <strong>Morton:</strong> Also known as Z-order curve, creates more
                  blocky, quadrant-based patterns with distinct regions.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="color-ordering">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Color Ordering</h3>
                <p class="feature-summary">HSV, HVS, SHV, SVH, VHS, VSH</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>HSV:</strong> Arranges colors by Hue, Saturation, Value
                  - emphasizing color families.
                </li>
                <li>
                  <strong>HVS:</strong> Arranges by Hue, Value, Saturation - emphasizing
                  brightness variations within hues.
                </li>
                <li>
                  <strong>SHV:</strong> Arranges by Saturation, Hue, Value - grouping
                  by color intensity first.
                </li>
                <li>
                  <strong>SVH:</strong> Arranges by Saturation, Value, Hue - emphasizing
                  intensity and brightness patterns.
                </li>
                <li>
                  <strong>VHS:</strong> Arranges by Value, Hue, Saturation - creating
                  bands of brightness.
                </li>
                <li>
                  <strong>VSH:</strong> Arranges by Value, Saturation, Hue - emphasizing
                  brightness and intensity patterns.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Tech Stack -->
      <section class="about-section reveal-element">
        <div class="section-pill">
          <span class="mono-text">05</span>
        </div>
        <h2 class="about-subheader">Tech Stack</h2>
        <div class="tech-grid">
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <span class="tech-name">Astro</span>
            <span class="tech-role mono-text">Framework</span>
          </div>
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="14.31" y1="8" x2="20.05" y2="17.94"/><line x1="9.69" y1="8" x2="21.17" y2="8"/><line x1="7.38" y1="12" x2="13.12" y2="2.06"/><line x1="9.69" y1="16" x2="3.95" y2="6.06"/><line x1="14.31" y1="16" x2="2.83" y2="16"/><line x1="16.62" y1="12" x2="10.88" y2="21.94"/></svg>
            </div>
            <span class="tech-name">React</span>
            <span class="tech-role mono-text">UI Library</span>
          </div>
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <span class="tech-name">Tailwind</span>
            <span class="tech-role mono-text">Styling</span>
          </div>
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <span class="tech-name">Canvas API</span>
            <span class="tech-role mono-text">Renderer</span>
          </div>
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <span class="tech-name">Web APIs</span>
            <span class="tech-role mono-text">Storage / Export</span>
          </div>
          <div class="tech-card">
            <div class="tech-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
            </div>
            <span class="tech-name">PDF / PNG</span>
            <span class="tech-role mono-text">Export Formats</span>
          </div>
        </div>
      </section>

      <!-- Technical Specifications -->
      <section class="about-section technical-specs reveal-element">
        <div class="section-pill">
          <span class="mono-text">06</span>
        </div>
        <h2 class="about-subheader">Technical Specifications</h2>
        <ul class="spec-list">
          <li>
            <span class="spec-label">Pattern Sizes</span>
            <span class="spec-value">From 128×128 to 4096×4096 pixels</span>
          </li>
          <li>
            <span class="spec-label">Algorithms</span>
            <span class="spec-value">Hilbert Curve, Morton Curve (Z-order)</span>
          </li>
          <li>
            <span class="spec-label">Export Options</span>
            <span class="spec-value">PNG and PDF formats</span>
          </li>
          <li>
            <span class="spec-label">Settings Storage</span>
            <span class="spec-value">Browser local storage for saved settings</span>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Feature cards expand/collapse functionality
  document.addEventListener("DOMContentLoaded", () => {
    const featureItems = document.querySelectorAll(".feature-item");

    featureItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;

      // Set initial ARIA attributes
      item.setAttribute("role", "button");
      item.setAttribute("tabindex", "0");
      item.setAttribute("aria-expanded", "false");
      const dataFeature = item.getAttribute("data-feature") || "feature";
      const detailsId = `details-${dataFeature}`;
      const details = item.querySelector(".feature-details");
      if (details) {
        details.id = detailsId;
        item.setAttribute("aria-controls", detailsId);
      }

      // Add click and keyboard event handlers
      item.addEventListener("click", (e) => {
        addClickEffect(item);
        toggleFeature(item, featureItems);
      });
      item.addEventListener("keydown", (e) => {
        if (
          e instanceof KeyboardEvent &&
          (e.key === "Enter" || e.key === " ")
        ) {
          e.preventDefault();
          addClickEffect(item);
          toggleFeature(item, featureItems);
        }
      });
    });

    function addClickEffect(item) {
      if (!(item instanceof HTMLElement)) return;
      item.classList.add("click-effect");
      setTimeout(() => {
        item.classList.remove("click-effect");
      }, 150);
    }

    function toggleFeature(item, allItems) {
      if (!(item instanceof HTMLElement)) return;
      const wasActive = item.classList.contains("active");

      // Close all items
      allItems.forEach((otherItem) => {
        if (!(otherItem instanceof HTMLElement)) return;
        otherItem.classList.remove("active");
        otherItem.setAttribute("aria-expanded", "false");
        const otherIcon = otherItem.querySelector(".feature-expand-icon");
        if (otherIcon) otherIcon.textContent = "+";
      });

      // If the clicked item wasn't active before, make it active
      if (!wasActive) {
        item.classList.add("active");
        item.setAttribute("aria-expanded", "true");
        const expandIcon = item.querySelector(".feature-expand-icon");
        if (expandIcon) expandIcon.textContent = "−";
      }
    }
  });
</script>

<style>
  /* ========================================
     ABOUT PAGE LAYOUT
     ======================================== */
  .about-page {
    width: min(960px, calc(100% - 2rem));
    margin: 0 auto 2rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .about-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .about-eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .about-header {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .about-meta {
    color: var(--color-ink-light);
    font-size: 0.8rem;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ========================================
     SECTIONS
     ======================================== */
  .about-section {
    position: relative;
    padding-left: 3rem;
  }

  .section-pill {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-ink);
    background: var(--color-paper);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .about-subheader {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-ink);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .about-card {
    background: var(--color-paper-alt);
    border: var(--border-ink);
    padding: 1.5rem;
    box-shadow: 6px 6px 0 0 var(--color-ink);
  }

  .about-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1rem;
    color: var(--color-ink-light);
  }

  .about-card p:last-child {
    margin-bottom: 0;
  }

  .about-link {
    margin-top: 1.5rem;
  }

  .about-link a {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    display: inline-block;
    padding: 0.6rem 1.25rem;
    border: var(--border-ink);
    background: var(--color-paper);
    box-shadow: 3px 3px 0 0 var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .about-link a:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--color-accent);
  }

  /* ========================================
     VIDEO
     ======================================== */
  .video-frame {
    margin-top: 2rem;
    background: var(--color-paper-alt);
    border: var(--border-ink);
    padding: 1.5rem;
    box-shadow: 6px 6px 0 0 var(--color-ink);
  }

  .video-eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .video-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-ink);
    margin: 0 0 1rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--color-accent);
  }

  .video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border: var(--border-ink);
    background: var(--color-paper);
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-caption {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-ink-light);
  }

  /* ========================================
     STEPS
     ======================================== */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .step-card {
    background: var(--color-paper-alt);
    border: var(--border-ink);
    padding: 1.5rem;
    box-shadow: 5px 5px 0 0 var(--color-ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .step-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 0 var(--color-accent);
  }

  .step-number {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    line-height: 2rem;
    text-align: center;
    border: var(--border-ink);
    background: var(--color-paper);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .step-card h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .step-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-light);
    margin: 0;
  }

  .parameter-list {
    list-style-type: none;
    padding-left: 0;
    margin: 0;
  }

  .parameter-list li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-light);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .parameter-list li::before {
    content: "■";
    color: var(--color-accent);
    flex-shrink: 0;
    font-size: 0.6rem;
    margin-top: 0.35rem;
  }

  /* ========================================
     FEATURE GRID
     ======================================== */
