---
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutVideoSchema = {
  "@type": "VideoObject",
  "@id": "https://art.jonathanrreed.com/about/#corridor-video",
  name: "I Made Art That HACKS Your Eyes",
  description:
    "Reference video that inspired the Algorithmic Art Gallery exploration of generated visual systems and perception-driven artwork.",
  thumbnailUrl: "https://i.ytimg.com/vi/SxsN6FRXMWQ/hqdefault.jpg",
  embedUrl: "https://www.youtube.com/embed/SxsN6FRXMWQ",
  publisher: {
    "@type": "Organization",
    name: "Corridor Crew",
  },
};
---

<BaseLayout
  title="Generative Art Process | Jonathan R. Reed"
  description="Learn how the Algorithmic Art Gallery by Jonathan R. Reed creates generative art using space-filling curves and mathematical algorithms."
  structuredData={[aboutVideoSchema]}
>
  <div class="about-page">
    <!-- Header -->
    <header class="about-hero" data-reveal>
      <p class="eyebrow about-hero-eyebrow">Process</p>
      <h1 class="about-header">About</h1>
      <p class="mono-text about-meta">
        Updated <time datetime="2026-04-21">April 21, 2026</time>.
      </p>
    </header>

    <div class="about-content">
      <!-- The Project -->
      <section class="about-section" data-reveal>
        <div class="section-pill">
          <span class="mono-text">01</span>
        </div>
        <h2 class="about-subheader">The Project</h2>
        <div class="about-card">
          <p>
            This is a small generative art project by me, Jonathan Reed! It uses
            space-filling curves (Hilbert, Morton, Peano) plus spiral and random-walk
            traversals, combined with color mapping to produce patterns. You control
            the seed, traversal curve, growth mode, symmetry, and color flow, then let
            the algorithm fill in the pixels.
          </p>
          <p>
            Every output is deterministic: the same settings produce the same
            image. Change a parameter and you get something new. It is mostly an
            experiment in what these algorithms can draw.
          </p>
          <p>
            The controls stay on screen and the gallery is one click away, so a
            piece you like is something you can come back to and push further.
          </p>
        </div>
        <p class="about-link">
          <a
            href="https://jonathanrreed.com/projects/"
            target="_blank"
            rel="noopener noreferrer"
          >
            See more projects →
          </a>
        </p>
      </section>

      <!-- Technology & Video -->
      <section class="about-section" data-reveal>
        <div class="section-pill">
          <span class="mono-text">02</span>
        </div>
        <h2 class="about-subheader">The Technology</h2>
        <div class="about-card">
          <p>
            Built with Astro and React, mostly static, with the heavy pixel work
            pushed into a Web Worker so the page still responds while a piece
            plots. The look borrows from drafting and plotter culture: warm paper,
            graphite ink, one oxide accent, and a real measurement grid. Quiet
            enough that the artwork is the loudest thing on the page.
          </p>
        </div>

        <div class="video-frame" data-reveal>
          <p class="eyebrow video-eyebrow">Reference</p>
          <h3 class="video-title">I Made Art That HACKS Your Eyes</h3>
          <div class="video-container">
            <iframe
              width="560"
              height="315"
              src="https://www.youtube.com/embed/SxsN6FRXMWQ?si=p4sz9KDZs15OeUoL"
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            >
            </iframe>
          </div>
          <p class="video-caption">
            The video is here as the reference for the visual idea. The generator
            is my own take on it, running in the browser off parameters you can
            write down and plot again later.
          </p>
        </div>
      </section>

      <!-- How It Works -->
      <section class="about-section" data-reveal>
        <div class="section-pill">
          <span class="mono-text">03</span>
        </div>
        <h2 class="about-subheader">How It Works</h2>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number mono-text">1</div>
            <h3>Select Parameters</h3>
            <ul class="parameter-list">
              <li>
                <strong>Seed & Growth</strong>: Control the seed value, pattern
                size, growth mode, seed shape, and more
              </li>
              <li>
                <strong>Color & Symmetry</strong>: Define the traversal curve, color
                progression, symmetry, and finishing effects
              </li>
            </ul>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">2</div>
            <h3>Generate</h3>
            <p>
              The worker walks the curve and fills in the pixels. Same settings,
              same picture, every time.
            </p>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">3</div>
            <h3>Export</h3>
            <p>
              Download it as a PNG or a PDF, anywhere from 128 × 128 up to
              4096 × 4096.
            </p>
          </div>
          <div class="step-card">
            <div class="step-number mono-text">4</div>
            <h3>Save</h3>
            <p>
              Keep the ones worth keeping in the local gallery.
            </p>
          </div>
        </div>
      </section>

      <!-- Pattern Generation Options -->
      <section class="about-section" data-reveal>
        <div class="section-pill">
          <span class="mono-text">04</span>
        </div>
        <h2 class="about-subheader">Pattern Generation Options</h2>
        <p class="feature-intro">
          Click on any option below to learn more about it:
        </p>
        <div class="feature-grid">
          <div class="feature-item" data-feature="render-modes">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Render Modes</h3>
                <p class="feature-summary">Color field, or line trace</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Color field:</strong> the traversal curve sets the order in
                  which every pixel is filled, and each is given a different color from a
                  palette spanning the whole color space, for a dense, painterly field.
                </li>
                <li>
                  <strong>Line trace:</strong> the curve itself is stroked as one
                  continuous colored line, color advancing along its length through the
                  chosen gradient (or a full hue sweep), for clean, plotted line art. Tune
                  the line weight and detail; every curve type traces its own signature.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="curve-types">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Curve Types</h3>
                <p class="feature-summary">Hilbert, Morton, Peano, Spiral, Random Walk</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Hilbert:</strong> A space-filling curve that preserves locality
                  well, creating smoother color transitions and more organic patterns.
                </li>
                <li>
                  <strong>Morton:</strong> The Z-order curve interleaves coordinate bits,
                  creating blockier, quadrant-based color regions.
                </li>
                <li>
                  <strong>Peano:</strong> A recursive 3×3 space-filling curve, a denser,
                  more woven path through color space than Hilbert.
                </li>
                <li>
                  <strong>Spiral:</strong> Archimedean-spiral ordering from the center
                  outward, so color winds out in rings.
                </li>
                <li>
                  <strong>Random Walk:</strong> A constrained, DLA-style random walk
                  orders the palette for organic, unpredictable color flow.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="growth-modes">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Growth Modes</h3>
                <p class="feature-summary">Crystal, Nebula, Rings, Flow</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Crystal:</strong> Grows outward by distance from the center,
                  forming crystalline, radial structures.
                </li>
                <li>
                  <strong>Nebula:</strong> Near-random growth priority produces cloud-like,
                  organic shapes with diffused edges.
                </li>
                <li>
                  <strong>Rings:</strong> Priority follows a sine of the radius, generating
                  concentric rings and orbital bands.
                </li>
                <li>
                  <strong>Flow:</strong> Growth follows a deterministic flow field, so
                  structure streams along curving currents.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="seed-shapes">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Seed Shapes</h3>
                <p class="feature-summary">Point, Dual, Circle, Line</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Point:</strong> Starts growth from a single point at the
                  center, creating a radial expansion pattern.
                </li>
                <li>
                  <strong>Dual:</strong> Begins from two seed points for paired,
                  symmetrical growth.
                </li>
                <li>
                  <strong>Circle:</strong> Begins with a circular boundary that expands
                  outward, creating ring-like structures.
                </li>
                <li>
                  <strong>Line:</strong> Initiates growth from a horizontal line across
                  the center, creating mirror-like patterns.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="symmetry">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Symmetry</h3>
                <p class="feature-summary">None, Bilateral, Quadrantal, Radial</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>None:</strong> No symmetry applied - pattern grows freely
                  in all directions without mirroring.
                </li>
                <li>
                  <strong>Bilateral:</strong> Mirror symmetry along a central axis,
                  like a butterfly's wings.
                </li>
                <li>
                  <strong>Quadrantal:</strong> Four-way symmetry, mirrored in four
                  quadrants from the center.
                </li>
                <li>
                  <strong>Radial:</strong> Eight-fold rotational symmetry radiating
                  from the center point.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="color-progression">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Color Progression</h3>
                <p class="feature-summary">Sequential, Shuffled, Base Distance, Saturation, Brightness</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Sequential:</strong> Colors follow a strict sequence based
                  on their position in the RGB space.
                </li>
                <li>
                  <strong>Shuffled:</strong> Colors are randomly arranged while maintaining
                  visual coherence.
                </li>
                <li>
                  <strong>Base Distance:</strong> Colors are distributed based on
                  their distance from a base color.
                </li>
                <li>
                  <strong>Saturation:</strong> Sorts the palette by saturation for an
                  AllRGB-style flow.
                </li>
                <li>
                  <strong>Brightness:</strong> Sorts the palette by brightness intensity.
                </li>
              </ul>
            </div>
          </div>
          <div class="feature-item" data-feature="finish">
            <div class="feature-header">
              <div class="feature-header-text">
                <h3>Finish &amp; Effects</h3>
                <p class="feature-summary">Gradient Map, Dithering, Anti-aliasing</p>
              </div>
              <span class="feature-expand-icon" aria-hidden="true">+</span>
            </div>
            <div class="feature-details">
              <ul>
                <li>
                  <strong>Gradient Map:</strong> Remaps the generated colors by brightness
                  through one of six palettes: sunset, ocean, monochrome, neon, forest, or magma.
                </li>
                <li>
                  <strong>Dithering:</strong> Ordered (Bayer) dithering adds fine tonal
                  texture and softens color banding.
                </li>
                <li>
                  <strong>Anti-aliasing:</strong> Edge-preserving smoothing softens harsh
                  boundaries between color regions.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Feature cards expand/collapse functionality
  (function () {
    if (window.__aagAbout) return;
    window.__aagAbout = true;
    document.addEventListener("astro:page-load", () => {
    const featureItems = document.querySelectorAll(".feature-item");
    if (!featureItems.length) return;

    featureItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;

      // Set initial ARIA attributes
      item.setAttribute("role", "button");
      item.setAttribute("tabindex", "0");
      item.setAttribute("aria-expanded", "false");
      const dataFeature = item.getAttribute("data-feature") || "feature";
      const detailsId = `details-${dataFeature}`;
      const details = item.querySelector(".feature-details");
      if (details) {
        details.id = detailsId;
        item.setAttribute("aria-controls", detailsId);
      }

      // Add click and keyboard event handlers
      item.addEventListener("click", (e) => {
        addClickEffect(item);
        toggleFeature(item, featureItems);
      });
      item.addEventListener("keydown", (e) => {
        if (
          e instanceof KeyboardEvent &&
          (e.key === "Enter" || e.key === " ")
        ) {
          e.preventDefault();
          addClickEffect(item);
          toggleFeature(item, featureItems);
        }
      });
    });

    function addClickEffect(item) {
      if (!(item instanceof HTMLElement)) return;
      item.classList.add("click-effect");
      setTimeout(() => {
        item.classList.remove("click-effect");
      }, 150);
    }

    function toggleFeature(item, allItems) {
      if (!(item instanceof HTMLElement)) return;
      const wasActive = item.classList.contains("active");

      // Close all items
      allItems.forEach((otherItem) => {
        if (!(otherItem instanceof HTMLElement)) return;
        otherItem.classList.remove("active");
        otherItem.setAttribute("aria-expanded", "false");
        const otherIcon = otherItem.querySelector(".feature-expand-icon");
        if (otherIcon) otherIcon.textContent = "+";
      });

      // If the clicked item wasn't active before, make it active
      if (!wasActive) {
        item.classList.add("active");
        item.setAttribute("aria-expanded", "true");
        const expandIcon = item.querySelector(".feature-expand-icon");
        if (expandIcon) expandIcon.textContent = "−";
      }
    }
    });
  })();
</script>

<style>
  /* ========================================
     ABOUT - a process documentation sheet
     ======================================== */
  .about-page {
    width: 100%;
    max-width: var(--page-max);
    margin: var(--section-gap) auto;
    padding-inline: var(--gutter);
    box-sizing: border-box;
  }

  /* Wider sheet, but keep long-form prose at a readable measure */
  .about-page p:not([class]),
  .step-content p,
  .feature-details p,
  .about-intro p {
    max-width: 68ch;
  }

  .about-hero {
    text-align: center;
    padding: 2.5rem 0 2.5rem;
  }

  /* eyebrow visuals come from the global .eyebrow; only spacing/centering here */
  .about-hero-eyebrow {
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .about-header {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 480;
    color: var(--ink);
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .about-meta {
    color: var(--ink-2);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  /* Sections with a drafting "plate" number */
  .about-section {
    position: relative;
    padding-left: 3.25rem;
  }

  .section-pill {
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 2.1rem;
    height: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--surface-border);
    background: var(--paper);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .about-subheader {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 470;
    color: var(--ink);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .about-card {
    background: var(--paper);
    border: var(--surface-border);
    border-left: var(--accent-stripe);
    padding: 1.5rem 1.75rem;
  }

  .about-card p {
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 1rem;
    color: var(--ink-2);
  }

  .about-card p:last-child {
    margin-bottom: 0;
  }

  .about-link {
    margin-top: 1.5rem;
  }

  .about-link a {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: var(--border-strong);
    background: var(--paper);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .about-link a:hover {
    background: var(--ink);
    color: var(--table);
  }

  /* Video - a reference plate */
  .video-frame {
    margin-top: 2rem;
    background: var(--paper);
    border: var(--surface-border);
    padding: 1.5rem;
  }

  .video-eyebrow {
    margin-bottom: 0.5rem;
  }

  .video-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 470;
    color: var(--ink);
    margin: 0 0 1rem;
    padding-left: 0.75rem;
    border-left: var(--accent-stripe);
  }

  .video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border: var(--surface-border);
    background: var(--paper-2);
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-caption {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* Steps */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: var(--surface-border);
  }

  .step-card {
    background: var(--paper);
    padding: 1.5rem;
    transition: background var(--transition-fast);
  }

  .step-card:hover {
    background: var(--paper-2);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: var(--surface-border);
    background: var(--paper-2);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .step-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 470;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }

  .step-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  .parameter-list {
    list-style-type: none;
    padding-left: 0;
    margin: 0;
  }

  .parameter-list li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .parameter-list li::before {
    content: "▸";
    color: var(--accent);
    flex-shrink: 0;
    font-size: 0.7rem;
    margin-top: 0.2rem;
  }

  /* Feature index (expandable) */
  .feature-intro {
    font-size: 0.95rem;
    color: var(--ink-2);
    margin-bottom: 1.25rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .feature-item {
    background: var(--paper);
    border: var(--surface-border);
    padding: 1.25rem;
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast);
    position: relative;
  }

  .feature-item:hover {
    border-color: var(--accent);
  }

  .feature-item.click-effect {
    background: var(--paper-2);
  }

  .feature-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .feature-header-text {
    min-width: 0;
  }

  .feature-item h3 {
    font-size: 0.95rem;
    font-family: var(--font-mono);
    color: var(--ink);
    margin: 0 0 0.35rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .feature-summary {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin: 0;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feature-expand-icon {
    color: var(--accent);
    font-size: 1.25rem;
    font-family: var(--font-mono);
    font-weight: 400;
    line-height: 1;
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .feature-item.active .feature-expand-icon {
    color: var(--accent);
    transform: rotate(45deg);
  }

  .feature-details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all var(--transition-slow);
    margin-top: 0;
  }

  .feature-item.active {
    background-color: var(--paper-2);
  }

  .feature-item.active .feature-details {
    max-height: 600px;
    opacity: 1;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--line-strong);
  }

  .feature-details ul {
    padding-left: 1rem;
    margin: 0;
    list-style-type: none;
  }

  .feature-details li {
    margin-bottom: 0.75rem;
    color: var(--ink-2);
    font-size: 0.85rem;
    line-height: 1.55;
    position: relative;
  }

  .feature-details li::before {
    content: "–";
    position: absolute;
    left: -1rem;
    color: var(--accent);
  }

  .feature-details li:last-child {
    margin-bottom: 0;
  }

  strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .about-section { padding-left: 0; }
    .section-pill { position: static; margin-bottom: 0.75rem; }
    .about-card { padding: 1.25rem; }
    .video-frame { padding: 1.25rem; }
    .steps-grid { grid-template-columns: 1fr; }
    .feature-grid { grid-template-columns: 1fr; }
  }

