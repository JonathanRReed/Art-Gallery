---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenerationPage from "../components/GenerationPage.jsx";

/* Hilbert space-filling curve, computed at build time for the hero's live trace. */
function hilbertPoints(order: number) {
  const n = 1 << order;
  const total = n * n;
  const pts = [];
  for (let d = 0; d < total; d++) {
    let t = d;
    let x = 0;
    let y = 0;
    for (let s = 1; s < n; s <<= 1) {
      const rx = 1 & (t >> 1);
      const ry = 1 & (t ^ rx);
      if (ry === 0) {
        if (rx === 1) {
          x = s - 1 - x;
          y = s - 1 - y;
        }
        const tmp = x;
        x = y;
        y = tmp;
      }
      x += s * rx;
      y += s * ry;
      t >>= 2;
    }
    pts.push([x, y]);
  }
  return { pts, n };
}

function toPath({ pts, n }: { pts: number[][]; n: number }, size = 200, pad = 10) {
  const inner = size - pad * 2;
  const step = inner / (n - 1);
  return pts
    .map(([x, y]: number[], i: number) => {
      const px = (pad + x * step).toFixed(2);
      const py = (pad + y * step).toFixed(2);
      return `${i === 0 ? "M" : "L"}${px} ${py}`;
    })
    .join(" ");
}

const heroPath = toPath(hilbertPoints(5));

// Curated starting points — each is a real, exact recipe the generator
// reproduces. The thumbnails are rendered live on the client from these same
// params, and clicking a card loads the recipe into the generator and plots it.
const PRESET_BASE = {
  seed: 1, curveType: "hilbert", growthMode: "crystal", seedShape: "point",
  symmetryMode: "none", colorProgression: "shuffled", branchingFactor: 0.5,
  growthRate: 1, randomness: 10, distanceRandomness: 10, colorSampleSize: 100,
  gradientMap: "none", dithering: false, antiAliasing: false,
  previewSize: 128, patternSize: 128, allRGBMode: false,
};
const presets = [
  { id: "crystal-bloom", name: "Crystal Bloom", sub: "Hilbert · radial", params: { ...PRESET_BASE, seed: 1337, symmetryMode: "radial" } },
  { id: "tidewater", name: "Tidewater", sub: "Morton · ocean", params: { ...PRESET_BASE, seed: 88, curveType: "morton", growthMode: "nebula", gradientMap: "ocean" } },
  { id: "solar-rings", name: "Solar Rings", sub: "Rings · sunset", params: { ...PRESET_BASE, seed: 42, growthMode: "rings", symmetryMode: "quadrantal", colorProgression: "sequential", gradientMap: "sunset" } },
  { id: "neon-spiral", name: "Neon Spiral", sub: "Spiral · neon", params: { ...PRESET_BASE, seed: 7, curveType: "spiral", colorProgression: "brightness", gradientMap: "neon" } },
  { id: "understory", name: "Understory", sub: "Peano · forest", params: { ...PRESET_BASE, seed: 256, curveType: "peano", growthMode: "flow", symmetryMode: "bilateral", colorProgression: "base-distance", gradientMap: "forest" } },
  { id: "magma-walk", name: "Magma Walk", sub: "Random walk · magma", params: { ...PRESET_BASE, seed: 99, curveType: "randomwalk", gradientMap: "magma" } },
];
---

<BaseLayout
  title="Generative Art Studio | Jonathan R Reed"
  description="Generate algorithmic artworks with curated controls, live previews, saved gallery studies, deterministic seeds, and high-resolution exports by Jonathan R Reed."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="art-index-title">
    <div class="hero-sheet crop">
      <span class="crop-tr"></span><span class="crop-bl"></span>

      <figure class="hero-plot">
        <div class="hero-plot-stage" id="hero-plot-stage">
          <svg class="hero-plot-svg" viewBox="0 0 200 200" role="img"
            aria-label="A Hilbert space-filling curve being plotted">
            <rect x="10" y="10" width="180" height="180" fill="none" stroke="var(--line-strong)" stroke-width="0.5" />
            <path id="hero-curve" class="plot-path" d={heroPath} pathLength="1" fill="none"
              stroke="var(--accent)" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" />
            <g class="plotter-head" aria-hidden="true">
              <circle r="3" fill="none" stroke="var(--ink)" stroke-width="1" />
              <line x1="-7" y1="0" x2="7" y2="0" stroke="var(--accent)" stroke-width="1" />
              <line x1="0" y1="-7" x2="0" y2="7" stroke="var(--accent)" stroke-width="1" />
              <animateMotion dur="3.4s" begin="0.2s" fill="freeze" rotate="0">
                <mpath href="#hero-curve" />
              </animateMotion>
            </g>
          </svg>
          <div class="plot-cross" id="plot-cross" aria-hidden="true">
            <span class="plot-cross-x"></span>
            <span class="plot-cross-y"></span>
            <span class="plot-cross-read mono" id="plot-cross-read">X000 Y000</span>
          </div>
        </div>
        <figcaption class="plot-tag">
          <span class="mono">FIG.01</span>
          <span>Hilbert order n=5 · 1,024 cells · live trace</span>
        </figcaption>
      </figure>

      <div class="hero-copy">
        <p class="eyebrow">Generative drawing instrument</p>
        <h1 id="art-index-title" class="hero-title">Algorithmic<br />Art Gallery</h1>
        <p class="hero-lead">
          Plot deterministic artwork from space-filling curves, growth modes,
          color progression, symmetry, and seeds. Every saved piece regenerates
          exactly from its settings — then exports for screen or print.
        </p>
        <dl class="titleblock">
          <div><dt>Author</dt><dd>Jonathan R Reed</dd></div>
          <div><dt>Method</dt><dd>Hilbert · Morton</dd></div>
          <div><dt>Output</dt><dd>PNG · PDF · 4096²</dd></div>
          <div><dt>Rev</dt><dd>2026.04.21</dd></div>
        </dl>
        <div class="hero-cta-group">
          <a href="#generator" class="btn-accent">Start plotting</a>
          <a href="/gallery/" class="btn">View gallery</a>
          <a href="/about/" class="btn-ghost">About<span class="sr-only"> the Algorithmic Art Gallery</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRESETS ===================== -->
  <section class="presets" aria-labelledby="presets-title">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Start from a pattern</p>
      <h2 id="presets-title" class="section-title">Recipes to remix</h2>
      <p class="section-desc">
        Each is a real, reproducible piece — pick one to load its exact recipe
        into the generator below, then make it your own.
      </p>
    </header>
    <div class="presets-grid" data-reveal>
      {presets.map((p) => (
        <button
          type="button"
          class="preset-card"
          data-preset={JSON.stringify(p.params)}
          aria-label={`Load and plot the ${p.name} pattern`}
        >
          <span class="preset-thumb">
            <canvas width="128" height="128" data-preset-canvas aria-hidden="true"></canvas>
            <span class="preset-plotting mono" aria-hidden="true">plotting…</span>
          </span>
          <span class="preset-meta">
            <span class="preset-name">{p.name}</span>
            <span class="preset-sub mono">{p.sub}</span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <!-- ===================== GENERATOR ===================== -->
  <section id="generator" class="generator">
    <header class="section-head" data-reveal>
      <p class="eyebrow">The instrument</p>
      <h2 class="section-title">Plot a new piece</h2>
    </header>

    <div class="art-loader" id="art-loader">
      <div class="loader-container crop">
        <span class="crop-tr"></span><span class="crop-bl"></span>
        <div class="loader-spinner" aria-hidden="true"></div>
        <div class="loader-text mono">Initializing plotter</div>
        <div class="loader-subtext mono">Loading the generative engine<span class="loader-cursor">_</span></div>
      </div>
    </div>

    <div class="generator-container">
      <GenerationPage client:only="react" />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    if (window.__aagIndex) return;
    window.__aagIndex = true;

    function initIndex() {
      // Under reduced-motion, remove the SMIL plotter head entirely so its
      // timeline never runs (CSS display:none only hides it).
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const head = document.querySelector(".plotter-head");
        if (head) head.remove();
      }

      // --- Loader: mask the gap until the React generator hydrates ---
      const loader = document.getElementById("art-loader");
      if (loader) {
        if (window.__aagLoaderDone) {
          loader.classList.add("fade-out");
          loader.style.display = "none";
        } else {
          let attempts = 0;
          const check = () => {
            const generator = document.querySelector(".generator-container");
            if (generator && generator.children.length > 0) {
              loader.classList.add("fade-out");
              setTimeout(() => { loader.style.display = "none"; }, 500);
              window.__aagLoaderDone = true;
              return;
            }
            if (attempts++ < 120) requestAnimationFrame(check);
          };
          setTimeout(() => {
            if (!loader.classList.contains("fade-out")) {
              loader.classList.add("fade-out");
              loader.style.display = "none";
              window.__aagLoaderDone = true;
            }
          }, 4000);
          setTimeout(check, 100);
        }
      }

      // --- Interactive coordinate crosshair over the hero plot ---
      const stage = document.getElementById("hero-plot-stage");
      const cross = document.getElementById("plot-cross");
      const read = document.getElementById("plot-cross-read");
      if (stage && cross && read && !stage.dataset.wired) {
        stage.dataset.wired = "1";
        const xline = cross.querySelector(".plot-cross-x");
        const yline = cross.querySelector(".plot-cross-y");
        const pad2 = (n) => String(n).padStart(2, "0");
        let rect = null;
        const invalidate = () => { rect = null; };
        stage.addEventListener("pointermove", (e) => {
          const r = rect || (rect = stage.getBoundingClientRect());
          const px = Math.min(Math.max(e.clientX - r.left, 0), r.width);
          const py = Math.min(Math.max(e.clientY - r.top, 0), r.height);
          if (xline) xline.style.top = py + "px";
          if (yline) yline.style.left = px + "px";
          read.style.left = px + "px";
          read.style.top = py + "px";
          // Real coordinate: which of the 32x32 Hilbert cells (order n=5) is under the cursor
          const col = Math.min(31, Math.floor((px / r.width) * 32));
          const row = Math.min(31, Math.floor((py / r.height) * 32));
          read.textContent = "C" + pad2(col) + " R" + pad2(row);
        });
        // Re-measure per hover session; invalidate on scroll/resize while active.
        // Listeners are scoped to the hover so nothing leaks across navigations.
        stage.addEventListener("pointerenter", () => {
          rect = stage.getBoundingClientRect();
          cross.classList.add("is-on");
          window.addEventListener("scroll", invalidate, { passive: true });
          window.addEventListener("resize", invalidate);
        });
        stage.addEventListener("pointerleave", () => {
          cross.classList.remove("is-on");
          window.removeEventListener("scroll", invalidate);
          window.removeEventListener("resize", invalidate);
        });
      }

      // --- Preset patterns: click a card to load its recipe + plot it ---
      const presetCards = Array.from(document.querySelectorAll(".preset-card"));
      if (presetCards.length && !window.__aagPresetsWired) {
        window.__aagPresetsWired = true;
        document.addEventListener("click", (e) => {
          const card = e.target.closest(".preset-card");
          if (!card || !card.dataset.preset) return;
          let params;
          try { params = JSON.parse(card.dataset.preset); } catch (err) { return; }
          window.dispatchEvent(new CustomEvent("aag-load-preset", { detail: params }));
          document.getElementById("generator")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }

      // Render preset thumbnails live from their real recipes, via a small worker pool
      const toRender = presetCards.filter((c) => !c.dataset.rendered);
      if (toRender.length) {
        let next = 0;
        const POOL = Math.min(3, toRender.length);
        const pump = (worker) => {
          if (!worker || next >= toRender.length) { if (worker) worker.terminate(); return; }
          const card = toRender[next++];
          const canvas = card.querySelector("canvas");
          let params;
          try { params = JSON.parse(card.dataset.preset); } catch (err) { card.dataset.rendered = "1"; return pump(worker); }
          const size = canvas ? canvas.width : 128;
          worker.onmessage = (e) => {
            if (e.data.error) { card.dataset.rendered = "1"; return pump(worker); }
            if (e.data.buffer && !e.data.preview) {
              try {
                const buf = new Uint8ClampedArray(e.data.buffer);
                canvas.getContext("2d").putImageData(new ImageData(buf, size, size), 0, 0);
                card.classList.add("is-rendered");
              } catch (err) {}
              card.dataset.rendered = "1";
              pump(worker);
            }
          };
          worker.postMessage({ ...params, width: size, height: size, patternComplexity: params.patternSize || size, previewMode: true });
        };
        for (let k = 0; k < POOL; k++) {
          let w = null;
          try { w = new Worker("/worker/color-mapper.js"); } catch (err) { w = null; }
          if (w) pump(w);
        }
      }
    }

    document.addEventListener("astro:page-load", initIndex);
  })();
</script>

<style>
  /* ===================== HERO ===================== */
  .hero {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(1.5rem, 5vw, 3.5rem) auto clamp(2.5rem, 6vw, 4rem);
  }

  .hero-sheet {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero-plot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hero-plot-svg {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    background: var(--paper-2);
    border: 1px solid var(--line);
    display: block;
  }

  .plot-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-on 3.4s var(--easing-smooth) 0.2s forwards;
  }

  .plot-tag {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .plot-tag .mono {
    color: var(--accent-strong);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  /* Plot stage holds the SVG + the interactive crosshair overlay */
  .hero-plot-stage {
    position: relative;
    cursor: crosshair;
  }

  /* Interactive coordinate crosshair — like a plotter bed readout */
  .plot-cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
    z-index: 2;
  }

  .plot-cross.is-on {
    opacity: 1;
  }

  .plot-cross-x,
  .plot-cross-y {
    position: absolute;
    background: var(--ink);
    opacity: 0.45;
  }

  .plot-cross-x { left: 0; right: 0; height: 1px; }
  .plot-cross-y { top: 0; bottom: 0; width: 1px; }

  .plot-cross-read {
    position: absolute;
    transform: translate(8px, 8px);
    padding: 0.12rem 0.36rem;
    background: var(--ink);
    color: var(--table);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Choreographed hero entrance — the sheet plots itself in */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* The plot bed stays still while it draws; the copy column staggers in */
  .hero-copy > .eyebrow,
  .hero-title,
  .hero-lead,
  .titleblock,
  .hero-cta-group {
    animation: heroIn 0.7s var(--easing-smooth) both;
  }

  .hero-copy > .eyebrow { animation-delay: 0.08s; }
  .hero-title { animation-delay: 0.16s; }
  .hero-lead { animation-delay: 0.3s; }
  .titleblock { animation-delay: 0.42s; }
  .hero-cta-group { animation-delay: 0.54s; }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 5.75rem);
    font-weight: 480;
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0.9rem 0 1.1rem;
    color: var(--ink);
  }

  .hero-lead {
    max-width: 54ch;
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.6rem;
  }

  .titleblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    margin: 0 0 1.75rem;
  }

  .titleblock > div {
    background: var(--paper);
    padding: 0.65rem 0.85rem;
  }

  .titleblock dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }

  .titleblock dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* ===================== SECTION HEADS ===================== */
  .section-head {
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0.7rem 0 0;
    max-width: 22ch;
  }

  .section-desc {
    max-width: 58ch;
    margin: 0.85rem 0 0;
    color: var(--ink-2);
    line-height: 1.7;
  }

  /* ===================== PRESETS ===================== */
  .presets {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(2rem, 5vw, 3.5rem) auto clamp(1.5rem, 4vw, 2.5rem);
  }

  .presets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.1rem;
    margin-top: 1.75rem;
  }

  .preset-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .preset-card:hover,
  .preset-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .preset-thumb {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .preset-thumb canvas {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .preset-card.is-rendered .preset-thumb canvas {
    opacity: 1;
  }

  .preset-plotting {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: opacity var(--transition-fast);
  }

  .preset-card.is-rendered .preset-plotting {
    opacity: 0;
  }

  /* "plot this" affordance slides up on hover */
  .preset-thumb::after {
    content: "↳ plot this";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    transform: translateY(100%);
    transition: transform var(--transition-base);
    pointer-events: none;
  }

  .preset-card:hover .preset-thumb::after,
  .preset-card:focus-visible .preset-thumb::after {
    transform: translateY(0);
  }

  .preset-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
  }

  .preset-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  .preset-sub {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  /* ===================== GENERATOR + LOADER ===================== */
  .generator {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .generator .section-head {
    align-self: center;
    text-align: center;
  }

  .generator .section-head .eyebrow {
    justify-content: center;
  }

  .generator-container {
    width: 100%;
  }

  .art-loader {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    background: var(--overlay);
    backdrop-filter: blur(6px);
    opacity: 1;
    transition: opacity 0.4s var(--easing-smooth);
  }

  .art-loader.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .loader-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: var(--paper);
    padding: 2.5rem 4rem;
    border: 1px solid var(--rule);
  }

  .loader-spinner {
    width: 38px;
    height: 38px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
  }

  .loader-text {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
  }

  .loader-subtext {
    color: var(--ink-2);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .loader-cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 860px) {
    .hero-sheet {
      grid-template-columns: 1fr;
    }
    .hero-plot {
      max-width: 360px;
    }
  }

  @media (max-width: 520px) {
    .hero-cta-group .btn,
    .hero-cta-group .btn-accent,
    .hero-cta-group .btn-ghost {
      flex: 1 1 100%;
    }
    .titleblock {
      grid-template-columns: 1fr;
    }
    .loader-container {
