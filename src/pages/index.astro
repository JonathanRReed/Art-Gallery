---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenerationPage from "../components/GenerationPage.jsx";
// import ControlsPanel from '../components/ControlsPanel.jsx';
// import PreviewCanvas from '../components/PreviewCanvas.jsx';
// import ExportPanel from '../components/ExportPanel.jsx';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout
	title="Algorithmic Art Gallery | Generative art by Jonathan R Reed"
	description="Algorithmic Art Gallery showcases generative and algorithmic pieces by Jonathan R Reed, blending code, systems thinking and visual design."
>
	<div class="intro-section">
		<p class="intro-text">
			<strong>Algorithmic Art Gallery</strong> is a collection of generative
			& algorithmic pieces you create <em>by Jonathan R Reed</em>.
		</p>
	</div>

	<div class="loading-skeleton" id="loading-skeleton">
		<div class="skeleton-layout">
			<!-- Controls Panel Skeleton -->
			<div class="skeleton-panel">
				<div class="skeleton-section">
					<div class="skeleton-heading"></div>
					<div class="skeleton-grid">
						<div class="skeleton-field">
							<div class="skeleton-label"></div>
							<div class="skeleton-input"></div>
						</div>
						<div class="skeleton-field">
							<div class="skeleton-label"></div>
							<div class="skeleton-input"></div>
						</div>
						<div class="skeleton-field">
							<div class="skeleton-label"></div>
							<div class="skeleton-input"></div>
						</div>
						<div class="skeleton-field">
							<div class="skeleton-label short"></div>
							<div class="skeleton-input"></div>
						</div>
					</div>
				</div>
				<div class="skeleton-section">
					<div class="skeleton-heading short"></div>
					<div class="skeleton-grid">
						<div class="skeleton-field">
							<div class="skeleton-label"></div>
							<div class="skeleton-input"></div>
						</div>
						<div class="skeleton-field">
							<div class="skeleton-label short"></div>
							<div class="skeleton-input"></div>
						</div>
					</div>
				</div>
				<div class="skeleton-button-generate"></div>
			</div>
			<!-- Preview Panel Skeleton -->
			<div class="skeleton-preview">
				<div class="skeleton-canvas">
					<div class="skeleton-canvas-loader">
						<div class="skeleton-spinner"></div>
					</div>
				</div>
				<div class="skeleton-actions">
					<div class="skeleton-action-btn"></div>
					<div class="skeleton-action-btn"></div>
				</div>
			</div>
		</div>
	</div>

	<div class="generator-container">
		<GenerationPage client:only="react" />
	</div>
</BaseLayout>

<script is:inline>
	// Hide skeleton when React component loads
	const checkReactLoaded = () => {
		const skeleton = document.getElementById("loading-skeleton");
		const generator = document.querySelector(".generator-container");
		if (generator && generator.children.length > 0) {
			if (skeleton) {
				skeleton.classList.add("fade-out");
				setTimeout(() => {
					skeleton.style.display = "none";
				}, 300);
			}
		} else {
			requestAnimationFrame(checkReactLoaded);
		}
	};
	// Start checking after a brief delay
	setTimeout(checkReactLoaded, 100);
</script>

<style>
	/* Premium Skeleton Loading Styles */
	.loading-skeleton {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 2rem;
		position: absolute;
		top: 80px;
		left: 0;
		right: 0;
		opacity: 1;
		transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.loading-skeleton.fade-out {
		opacity: 0;
		pointer-events: none;
	}

	/* Layout matching actual content */
	.skeleton-layout {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: flex-start;
		gap: 2rem;
	}

	/* Controls Panel Skeleton */
	.skeleton-panel {
		flex: 0 0 auto;
		width: 600px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 0.75rem;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.skeleton-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.skeleton-heading {
		height: 20px;
		width: 140px;
		background: rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.skeleton-heading.short {
		width: 100px;
	}

	.skeleton-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.skeleton-field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.skeleton-label {
		height: 12px;
		width: 80px;
		background: rgba(255, 255, 255, 0.04);
		border-radius: 3px;
		animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
		animation-delay: 0.1s;
	}

	.skeleton-label.short {
		width: 60px;
	}

	.skeleton-input {
		height: 40px;
		width: 100%;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 6px;
		animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
		animation-delay: 0.2s;
	}

	.skeleton-button-generate {
		height: 44px;
		width: 100%;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 6px;
		margin-top: 0.5rem;
		animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
		animation-delay: 0.3s;
	}

	/* Preview Panel Skeleton */
	.skeleton-preview {
		flex: 1 0 auto;
		max-width: 600px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.skeleton-canvas {
		width: 100%;
		max-width: 400px;
		aspect-ratio: 1/1;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.skeleton-canvas::before {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(
			ellipse at center,
			rgba(103, 232, 249, 0.03) 0%,
			transparent 70%
		);
		animation: skeleton-glow 3s ease-in-out infinite;
	}

	.skeleton-canvas-loader {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.skeleton-spinner {
		width: 32px;
		height: 32px;
		border: 2px solid rgba(255, 255, 255, 0.06);
		border-top-color: rgba(103, 232, 249, 0.3);
		border-radius: 50%;
		animation: skeleton-spin 1s linear infinite;
	}

	.skeleton-actions {
		display: flex;
		gap: 0.75rem;
		width: 100%;
		max-width: 400px;
	}

	.skeleton-action-btn {
		flex: 1;
		height: 40px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 6px;
		animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
		animation-delay: 0.4s;
	}

	/* Premium Animations */
	@keyframes skeleton-pulse {
		0%,
		100% {
			opacity: 0.5;
		}
		50% {
			opacity: 1;
		}
	}

	@keyframes skeleton-glow {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(0.95);
		}
		50% {
			opacity: 0.6;
			transform: scale(1.05);
		}
	}

	@keyframes skeleton-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Intro section styles */
	.intro-section {
		width: 100%;
		max-width: 700px;
		margin: 0 auto 2rem;
		padding: 1rem 1.5rem;
		text-align: center;
		background: rgba(15, 23, 42, 0.5);
		border: 1px solid rgba(103, 232, 249, 0.1);
		border-radius: 12px;
	}

	.intro-text {
		color: #94a3b8;
		font-size: 0.95rem;
		line-height: 1.7;
		margin: 0;
	}

	.intro-text strong {
		color: #f1f5f9;
		font-weight: 600;
	}

	.intro-text em {
		color: #67e8f9;
		font-style: normal;
	}

	.generator-container {
		width: 100%;
	}

	/* Mobile responsiveness */
	@media (max-width: 1200px) {
		.skeleton-panel {
			width: 550px;
		}
	}

	@media (max-width: 1100px) {
		.skeleton-grid {
			grid-template-columns: 1fr;
		}

		.skeleton-panel {
			width: 400px;
		}
	}

	@media (max-width: 900px) {
		.skeleton-layout {
			flex-direction: column;
			align-items: center;
		}

		.skeleton-panel {
			width: 100%;
			max-width: 600px;
			order: 1;
		}

		.skeleton-preview {
			width: 100%;
			order: 0;
			margin-bottom: 1.5rem;
		}

		.skeleton-canvas {
			max-width: 100%;
		}

		.skeleton-actions {
			max-width: 100%;
		}
	}

	/* Reduced motion preference */
	@media (prefers-reduced-motion: reduce) {
		.skeleton-heading,
		.skeleton-label,
		.skeleton-input,
		.skeleton-button-generate,
		.skeleton-action-btn {
			animation: none;
			opacity: 0.7;
		}

		.skeleton-spinner {
			animation: none;
			border-color: rgba(103, 232, 249, 0.3);
		}

		.skeleton-canvas::before {
			animation: none;
			opacity: 0.4;
		}
	}
</style>
