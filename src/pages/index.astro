---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenerationPage from "../components/GenerationPage.jsx";
// import ControlsPanel from '../components/ControlsPanel.jsx';
// import PreviewCanvas from '../components/PreviewCanvas.jsx';
// import ExportPanel from '../components/ExportPanel.jsx';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<BaseLayout
	title="Algorithmic Art Gallery | Generative art by Jonathan R Reed"
	description="Algorithmic Art Gallery showcases algorithmic pieces by Jonathan R Reed, blending code, systems thinking and visual design."
>
	<div class="intro-section">
		<h1 class="intro-heading">THE GENERATOR</h1>
		<p class="intro-text mono-text">
			SELECT PARAMETERS. INITIALIZE GROWTH ALGORITHM. OBSERVE FORMATION.
			<br /><span class="accent-text">A SYSTEM BY JONATHAN R REED.</span>
		</p>
	</div>

	<!-- Minimalist Brutal Loader -->
	<div class="art-loader" id="art-loader">
		<div class="loader-container">
			<div class="brutal-spinner"></div>
			<div class="loader-text mono-text">[INITIALIZING SYSTEM]</div>
		</div>
	</div>

	<div class="generator-container">
		<GenerationPage client:only="react" />
	</div>
</BaseLayout>

<script is:inline>
	// Hide loader when React component loads
	const checkReactLoaded = () => {
		const loader = document.getElementById("art-loader");
		const generator = document.querySelector(".generator-container");
		if (generator && generator.children.length > 0) {
			if (loader) {
				loader.classList.add("fade-out");
				setTimeout(() => {
					loader.style.display = "none";
				}, 500);
			}
		} else {
			requestAnimationFrame(checkReactLoaded);
		}
	};
	// Start checking after a brief delay
	setTimeout(checkReactLoaded, 100);
</script>

<style>
	/* ========================================
	   INTRO SECTION
	   ======================================== */
	.intro-section {
		width: 100%;
		max-width: 800px;
		margin: 0 auto 3rem;
		padding: 2rem;
		text-align: center;
		background: var(--color-paper);
		border-top: 4px solid var(--color-ink);
		border-bottom: 4px solid var(--color-ink);
		box-shadow: 8px 8px 0 0 var(--color-ink);
	}

	.intro-heading {
		font-family: var(--font-serif);
		font-size: 3rem;
		font-weight: 400;
		color: var(--color-ink);
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.intro-text {
		color: var(--color-ink-light);
		line-height: 1.6;
		margin: 0;
	}

	.accent-text {
		color: var(--color-accent);
		font-weight: 600;
	}

	/* ========================================
	   BRUTAL MINIMAL LOADER
	   ======================================== */
	.art-loader {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 50;
		background: var(--color-paper);
		opacity: 1;
		transition: opacity 0.3s ease;
	}

	.art-loader.fade-out {
		opacity: 0;
		pointer-events: none;
	}

	.loader-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		background: var(--color-paper-alt);
		padding: 2rem 4rem;
		border: var(--border-ink);
		box-shadow: 12px 12px 0 0 var(--color-ink);
	}

	.brutal-spinner {
		width: 40px;
		height: 40px;
		border: 4px solid var(--color-ink);
		border-right-color: transparent;
		animation: spin 0.8s linear infinite;
	}

	.loader-text {
		color: var(--color-ink);
		font-weight: 600;
		animation: blink 1s step-end infinite;
	}

	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	.generator-container {
		width: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.brutal-spinner {
			animation: none;
			border-right-color: var(--color-ink);
		}
		.loader-text {
			animation: none;
		}
	}

	@media (max-width: 768px) {
		.intro-section {
			margin: 0 1rem 2rem;
			width: auto;
		}
		.intro-heading {
			font-size: 2rem;
		}
	}
</style>
