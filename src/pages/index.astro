---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenerationPage from "../components/GenerationPage.jsx";

/* ------------------------------------------------------------------
   Space-filling curves, computed at build time. These are the exact
   traversals the generator uses — rendered here as honest line art
   instead of decorative gradients.
   ------------------------------------------------------------------ */
function hilbertPoints(order: number) {
  const n = 1 << order;
  const total = n * n;
  const pts = [];
  for (let d = 0; d < total; d++) {
    let t = d;
    let x = 0;
    let y = 0;
    for (let s = 1; s < n; s <<= 1) {
      const rx = 1 & (t >> 1);
      const ry = 1 & (t ^ rx);
      if (ry === 0) {
        if (rx === 1) {
          x = s - 1 - x;
          y = s - 1 - y;
        }
        const tmp = x;
        x = y;
        y = tmp;
      }
      x += s * rx;
      y += s * ry;
      t >>= 2;
    }
    pts.push([x, y]);
  }
  return { pts, n };
}

function mortonPoints(order: number) {
  const n = 1 << order;
  const total = n * n;
  const pts = [];
  for (let d = 0; d < total; d++) {
    let x = 0;
    let y = 0;
    for (let i = 0; i < order; i++) {
      x |= ((d >> (2 * i)) & 1) << i;
      y |= ((d >> (2 * i + 1)) & 1) << i;
    }
    pts.push([x, y]);
  }
  return { pts, n };
}

function toPath({ pts, n }: { pts: number[][]; n: number }, size = 200, pad = 10) {
  const inner = size - pad * 2;
  const step = inner / (n - 1);
  return pts
    .map(([x, y]: number[], i: number) => {
      const px = (pad + x * step).toFixed(2);
      const py = (pad + y * step).toFixed(2);
      return `${i === 0 ? "M" : "L"}${px} ${py}`;
    })
    .join(" ");
}

const heroPath = toPath(hilbertPoints(5));
const showcase = [
  { d: toPath(hilbertPoints(5)), kind: "hilbert", label: "Hilbert · order 5", hint: "1,024 cells · locality-preserving", stroke: "var(--accent)" },
  { d: toPath(mortonPoints(5)), kind: "morton", label: "Morton · order 5", hint: "Z-order traversal · quadrant blocks", stroke: "var(--ink)" },
  { d: toPath(hilbertPoints(3)), kind: "hilbert", label: "Hilbert · order 3", hint: "64 cells · the base motif", stroke: "var(--accent)" },
  { d: toPath(mortonPoints(4)), kind: "morton", label: "Morton · order 4", hint: "256 cells · recursive Z", stroke: "var(--ink)" },
];

const features = [
  { n: "00", title: "Deterministic output", body: "Identical settings always produce the identical image. Every run is a reproducible study, recreatable from its parameters." },
  { n: "01", title: "Space-filling curves", body: "Hilbert or Morton traversal decides how the canvas is visited — and therefore how color flows across the plate." },
  { n: "02", title: "Symmetry rules", body: "None, bilateral, quadrantal, or radial. Each rule folds the same seed into a different composition." },
  { n: "03", title: "High-resolution export", body: "Render finished pieces to PNG or PDF at up to 4096×4096 — ready for print, screen, or portfolio." },
  { n: "04", title: "Saved gallery", body: "Keep the strongest studies with their exact settings. Return later to compare, refine, or re-export." },
  { n: "05", title: "Live preview", body: "Adjust a control and watch the plate redraw in real time. Experiment fast, commit with intent." },
];
---

<BaseLayout
  title="Generative Art Studio | Jonathan R Reed"
  description="Generate algorithmic artworks with curated controls, live previews, saved gallery studies, deterministic seeds, and high-resolution exports by Jonathan R Reed."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="art-index-title">
    <div class="hero-sheet crop">
      <span class="crop-tr"></span><span class="crop-bl"></span>

      <figure class="hero-plot">
        <div class="hero-plot-stage" id="hero-plot-stage">
          <svg class="hero-plot-svg" viewBox="0 0 200 200" role="img"
            aria-label="A Hilbert space-filling curve being plotted">
            <rect x="10" y="10" width="180" height="180" fill="none" stroke="var(--line-strong)" stroke-width="0.5" />
            <path id="hero-curve" class="plot-path" d={heroPath} pathLength="1" fill="none"
              stroke="var(--accent)" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" />
            <g class="plotter-head" aria-hidden="true">
              <circle r="3" fill="none" stroke="var(--ink)" stroke-width="1" />
              <line x1="-7" y1="0" x2="7" y2="0" stroke="var(--accent)" stroke-width="1" />
              <line x1="0" y1="-7" x2="0" y2="7" stroke="var(--accent)" stroke-width="1" />
              <animateMotion dur="3.4s" begin="0.2s" fill="freeze" rotate="0">
                <mpath href="#hero-curve" />
              </animateMotion>
            </g>
          </svg>
          <div class="plot-cross" id="plot-cross" aria-hidden="true">
            <span class="plot-cross-x"></span>
            <span class="plot-cross-y"></span>
            <span class="plot-cross-read mono" id="plot-cross-read">X000 Y000</span>
          </div>
        </div>
        <figcaption class="plot-tag">
          <span class="mono">FIG.01</span>
          <span>Hilbert order n=5 · 1,024 cells · live trace</span>
        </figcaption>
      </figure>

      <div class="hero-copy">
        <p class="eyebrow">Generative drawing instrument</p>
        <h1 id="art-index-title" class="hero-title">Algorithmic<br />Art Gallery</h1>
        <p class="hero-lead">
          Plot deterministic artwork from space-filling curves, growth modes,
          color ordering, symmetry, and seeds. Every saved piece regenerates
          exactly from its settings — then exports for screen or print.
        </p>
        <dl class="titleblock">
          <div><dt>Author</dt><dd>Jonathan R Reed</dd></div>
          <div><dt>Method</dt><dd>Hilbert · Morton</dd></div>
          <div><dt>Output</dt><dd>PNG · PDF · 4096²</dd></div>
          <div><dt>Rev</dt><dd>2026.04.21</dd></div>
        </dl>
        <div class="hero-cta-group">
          <a href="#generator" class="btn-accent">Start plotting</a>
          <a href="/gallery/" class="btn">View gallery</a>
          <a href="/about/" class="btn-ghost">About<span class="sr-only"> the Algorithmic Art Gallery</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SHOWCASE ===================== -->
  <section class="showcase" aria-labelledby="showcase-title">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Plate index</p>
      <h2 id="showcase-title" class="section-title">The curves the tool draws</h2>
      <p class="section-desc">
        Every image begins as one of these traversals. Color and symmetry are
        applied along the path — change the curve and the whole composition reorders.
      </p>
    </header>
    <div class="rule-ticks" aria-hidden="true" data-reveal></div>
    <div class="showcase-grid">
      {showcase.map((c, i) => (
        <figure class="showcase-card crop" data-reveal>
          <span class="crop-tr"></span><span class="crop-bl"></span>
          <div class="showcase-plot">
            <svg viewBox="0 0 200 200" role="img" aria-label={`${c.label} space-filling curve`}>
              <path class="showcase-path" style={`--i:${i}`} d={c.d} pathLength="1" fill="none"
                stroke={c.stroke} stroke-width="1.3" stroke-linecap="square" stroke-linejoin="miter" />
            </svg>
          </div>
          <figcaption class="showcase-caption">
            <span class="mono showcase-label">{c.label}</span>
            <span class="showcase-hint">{c.hint}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ===================== FEATURES (legend) ===================== -->
  <section class="features" aria-labelledby="features-title">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Capabilities</p>
      <h2 id="features-title" class="section-title">A studio built for deliberate exploration</h2>
    </header>
    <ol class="legend" data-reveal>
      {features.map((f) => (
        <li class="legend-row">
          <span class="legend-n mono">{f.n}</span>
          <div class="legend-body">
            <h3 class="legend-title">{f.title}</h3>
            <p class="legend-text">{f.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== STUDIO NOTES ===================== -->
  <section class="notes" aria-labelledby="notes-title">
    <details class="notes-sheet" data-reveal>
      <summary id="notes-title">Studio notes</summary>
      <div class="notes-body">
        <p>
          The studio is built for deliberate exploration, not random effects.
          Compare Hilbert against Morton traversal, change how color moves through
          the image, then save the strongest variations to the gallery for review.
        </p>
        <p>
          A seed defines the starting point, a traversal curve determines how the
          canvas is visited, and the color rules decide how structure becomes
          visible. Adjust one setting at a time when you want to compare related outputs.
        </p>
        <p>
          Small parameter changes often explain the system better than a brand-new
          random seed. Keep the saved versions that show a clear difference in
          density, symmetry, or color rhythm.
        </p>
        <p>
          When a run works, save it before changing controls. Comparing saved
          outputs against the live plate makes it easier to spot which choice
          actually improved the piece: the curve, the symmetry, the seed, or the color path.
        </p>
      </div>
    </details>
  </section>

  <!-- ===================== GENERATOR ===================== -->
  <section id="generator" class="generator">
    <header class="section-head" data-reveal>
      <p class="eyebrow">The instrument</p>
      <h2 class="section-title">Plot a new piece</h2>
    </header>

    <div class="art-loader" id="art-loader">
      <div class="loader-container crop">
        <span class="crop-tr"></span><span class="crop-bl"></span>
        <div class="loader-spinner" aria-hidden="true"></div>
        <div class="loader-text mono">Initializing plotter</div>
        <div class="loader-subtext mono">Loading the generative engine<span class="loader-cursor">_</span></div>
      </div>
    </div>

    <div class="generator-container">
      <GenerationPage client:only="react" />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    if (window.__aagIndex) return;
    window.__aagIndex = true;

    function initIndex() {
      // Under reduced-motion, remove the SMIL plotter head entirely so its
      // timeline never runs (CSS display:none only hides it).
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const head = document.querySelector(".plotter-head");
        if (head) head.remove();
      }

      // --- Loader: mask the gap until the React generator hydrates ---
      const loader = document.getElementById("art-loader");
      if (loader) {
        if (window.__aagLoaderDone) {
          loader.classList.add("fade-out");
          loader.style.display = "none";
        } else {
          let attempts = 0;
          const check = () => {
            const generator = document.querySelector(".generator-container");
            if (generator && generator.children.length > 0) {
              loader.classList.add("fade-out");
              setTimeout(() => { loader.style.display = "none"; }, 500);
              window.__aagLoaderDone = true;
              return;
            }
            if (attempts++ < 120) requestAnimationFrame(check);
          };
          setTimeout(() => {
            if (!loader.classList.contains("fade-out")) {
              loader.classList.add("fade-out");
              loader.style.display = "none";
              window.__aagLoaderDone = true;
            }
          }, 4000);
          setTimeout(check, 100);
        }
      }

      // --- Interactive coordinate crosshair over the hero plot ---
      const stage = document.getElementById("hero-plot-stage");
      const cross = document.getElementById("plot-cross");
      const read = document.getElementById("plot-cross-read");
      if (stage && cross && read && !stage.dataset.wired) {
        stage.dataset.wired = "1";
        const xline = cross.querySelector(".plot-cross-x");
        const yline = cross.querySelector(".plot-cross-y");
        const pad2 = (n) => String(n).padStart(2, "0");
        let rect = null;
        const invalidate = () => { rect = null; };
        stage.addEventListener("pointermove", (e) => {
          const r = rect || (rect = stage.getBoundingClientRect());
          const px = Math.min(Math.max(e.clientX - r.left, 0), r.width);
          const py = Math.min(Math.max(e.clientY - r.top, 0), r.height);
          if (xline) xline.style.top = py + "px";
          if (yline) yline.style.left = px + "px";
          read.style.left = px + "px";
          read.style.top = py + "px";
          // Real coordinate: which of the 32x32 Hilbert cells (order n=5) is under the cursor
          const col = Math.min(31, Math.floor((px / r.width) * 32));
          const row = Math.min(31, Math.floor((py / r.height) * 32));
          read.textContent = "C" + pad2(col) + " R" + pad2(row);
        });
        // Re-measure per hover session; invalidate on scroll/resize while active.
        // Listeners are scoped to the hover so nothing leaks across navigations.
        stage.addEventListener("pointerenter", () => {
          rect = stage.getBoundingClientRect();
          cross.classList.add("is-on");
          window.addEventListener("scroll", invalidate, { passive: true });
          window.addEventListener("resize", invalidate);
        });
        stage.addEventListener("pointerleave", () => {
          cross.classList.remove("is-on");
          window.removeEventListener("scroll", invalidate);
          window.removeEventListener("resize", invalidate);
        });
      }
    }

    document.addEventListener("astro:page-load", initIndex);
  })();
</script>

<style>
  /* ===================== HERO ===================== */
  .hero {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(1.5rem, 5vw, 3.5rem) auto clamp(2.5rem, 6vw, 4rem);
  }

  .hero-sheet {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero-plot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hero-plot-svg {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    background: var(--paper-2);
    border: 1px solid var(--line);
    display: block;
  }

  .plot-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-on 3.4s var(--easing-smooth) 0.2s forwards;
  }

  .plot-tag {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .plot-tag .mono {
    color: var(--accent-strong);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  /* Plot stage holds the SVG + the interactive crosshair overlay */
  .hero-plot-stage {
    position: relative;
    cursor: crosshair;
  }

  /* Interactive coordinate crosshair — like a plotter bed readout */
  .plot-cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
    z-index: 2;
  }

  .plot-cross.is-on {
    opacity: 1;
  }

  .plot-cross-x,
  .plot-cross-y {
    position: absolute;
    background: var(--ink);
    opacity: 0.45;
  }

  .plot-cross-x { left: 0; right: 0; height: 1px; }
  .plot-cross-y { top: 0; bottom: 0; width: 1px; }

  .plot-cross-read {
    position: absolute;
    transform: translate(8px, 8px);
    padding: 0.12rem 0.36rem;
    background: var(--ink);
    color: var(--table);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Choreographed hero entrance — the sheet plots itself in */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* The plot bed stays still while it draws; the copy column staggers in */
  .hero-copy > .eyebrow,
  .hero-title,
  .hero-lead,
  .titleblock,
  .hero-cta-group {
    animation: heroIn 0.7s var(--easing-smooth) both;
  }

  .hero-copy > .eyebrow { animation-delay: 0.08s; }
  .hero-title { animation-delay: 0.16s; }
  .hero-lead { animation-delay: 0.3s; }
  .titleblock { animation-delay: 0.42s; }
  .hero-cta-group { animation-delay: 0.54s; }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 5.75rem);
    font-weight: 480;
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0.9rem 0 1.1rem;
    color: var(--ink);
  }

  .hero-lead {
    max-width: 54ch;
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.6rem;
  }

  .titleblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    margin: 0 0 1.75rem;
  }

  .titleblock > div {
    background: var(--paper);
    padding: 0.65rem 0.85rem;
  }

  .titleblock dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }

  .titleblock dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* ===================== SECTION HEADS ===================== */
  .section-head {
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0.7rem 0 0;
    max-width: 22ch;
  }

  .section-desc {
    max-width: 58ch;
    margin: 0.85rem 0 0;
    color: var(--ink-2);
    line-height: 1.7;
  }

  /* ===================== SHOWCASE ===================== */
  .showcase {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(2.5rem, 6vw, 4.5rem) auto;
  }

  .showcase .rule-ticks {
    margin: 1.5rem 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .showcase-card {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-base);
  }

  .showcase-card:hover {
    border-color: var(--accent);
  }

  .showcase-plot {
    padding: 1rem;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    cursor: crosshair;
    overflow: hidden;
  }

  .showcase-plot svg {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    display: block;
    transition: transform var(--transition-slow);
  }

  .showcase-card:hover .showcase-plot svg {
    transform: scale(1.04);
  }

  .showcase-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-on 2.6s var(--easing-smooth) calc(var(--i) * 0.18s + 0.3s) forwards;
    transition: stroke var(--transition-base);
  }

  /* On hover, every plate re-inks in the oxide plot-colour */
  .showcase-card:hover .showcase-path {
    stroke: var(--accent);
  }

  .showcase-caption {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .showcase-label {
    font-size: 0.72rem;
    color: var(--ink);
    letter-spacing: 0.1em;
  }

  .showcase-hint {
    font-size: 0.82rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  /* ===================== FEATURES / LEGEND ===================== */
  .features {
    width: min(1080px, calc(100% - 2rem));
    margin: clamp(2.5rem, 6vw, 4.5rem) auto;
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .legend-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    transition: background var(--transition-fast);
  }

  .legend-row:hover {
    background: var(--paper);
  }

  .legend-n {
    font-size: 0.85rem;
    color: var(--accent-strong);
    letter-spacing: 0.05em;
    padding-top: 0.2rem;
  }

  .legend-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 480;
    color: var(--ink);
    margin: 0 0 0.3rem;
    letter-spacing: -0.01em;
  }

  .legend-text {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  /* ===================== STUDIO NOTES ===================== */
  .notes {
    width: min(1080px, calc(100% - 2rem));
    margin: clamp(2rem, 5vw, 3.5rem) auto;
  }

  .notes-sheet {
    background: var(--paper);
    border: 1px solid var(--line-strong);
  }

  .notes-sheet summary {
    cursor: pointer;
    list-style-position: inside;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 1rem 1.25rem;
    color: var(--ink);
  }

  .notes-sheet summary:hover {
    color: var(--accent);
  }

  .notes-body {
    padding: 0 1.25rem 1.25rem;
    columns: 2;
    column-gap: 2.5rem;
  }

  .notes-body p {
    margin: 0 0 1rem;
    color: var(--ink-2);
    line-height: 1.7;
    font-size: 0.92rem;
    break-inside: avoid;
  }

  /* ===================== GENERATOR + LOADER ===================== */
  .generator {
    width: min(1240px, calc(100% - 2rem));
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .generator .section-head {
    align-self: center;
    text-align: center;
  }

  .generator .section-head .eyebrow {
    justify-content: center;
  }

  .generator-container {
    width: 100%;
  }

  .art-loader {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    background: var(--overlay);
    backdrop-filter: blur(6px);
    opacity: 1;
    transition: opacity 0.4s var(--easing-smooth);
  }

  .art-loader.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .loader-container {
