---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenerationPage from "../components/GenerationPage.jsx";
---

<BaseLayout
  title="Generative Art Studio | Jonathan R Reed"
  description="Generate algorithmic artworks with curated controls, live previews, saved gallery studies, deterministic seeds, and high-resolution exports by Jonathan R Reed."
>
  <!-- Hero Section -->
  <section class="hero-section" aria-labelledby="art-index-title">
    <div class="hero-background" aria-hidden="true">
      <div class="mesh-blob blob-1"></div>
      <div class="mesh-blob blob-2"></div>
      <div class="mesh-blob blob-3"></div>
      <div class="mesh-blob blob-4"></div>
      <div class="mesh-grid"></div>
    </div>
    <div class="hero-content">
      <p class="mono-text hero-eyebrow">Generative art studio</p>
      <h1 id="art-index-title" class="hero-title">Algorithmic<br />Art Gallery</h1>
      <p class="mono-text hero-meta">
        By Jonathan R Reed. Updated <time datetime="2026-04-21">April 21, 2026</time>.
      </p>
      <p class="hero-lead">
        Build deterministic artwork from space-filling curves, growth modes,
        color ordering, symmetry rules, and seed controls. Every saved output
        can be regenerated from the same settings, then exported for sharing or
        printing.
      </p>
      <div class="hero-cta-group">
        <a href="#generator" class="cta-primary">Start Creating</a>
        <a href="/gallery/" class="cta-secondary">View Gallery</a>
        <a href="/about/" class="cta-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Showcase Section -->
  <section class="showcase-section" aria-labelledby="showcase-title">
    <div class="showcase-header reveal-element">
      <p class="mono-text showcase-eyebrow">Visual systems</p>
      <h2 id="showcase-title" class="showcase-title">What the algorithm draws</h2>
      <p class="showcase-desc">
        A small sample of the patterns produced by varying symmetry, curve traversal, and color ordering.
      </p>
    </div>
    <div class="showcase-grid">
      <div class="showcase-card reveal-element" role="img" aria-label="Radial symmetry pattern with concentric color rings">
        <div class="art-placeholder art-radial"></div>
        <div class="showcase-card-caption">
          <span class="caption-label mono-text">Radial / Sequential</span>
          <span class="caption-hint">Hilbert curve</span>
        </div>
      </div>
      <div class="showcase-card reveal-element" role="img" aria-label="Quadrant mirror pattern with angular geometric blocks">
        <div class="art-placeholder art-quadrant"></div>
        <div class="showcase-card-caption">
          <span class="caption-label mono-text">Quadrantal / HSV</span>
          <span class="caption-hint">Morton Z-order</span>
        </div>
      </div>
      <div class="showcase-card reveal-element" role="img" aria-label="Organic nebula pattern with soft diffused gradients">
        <div class="art-placeholder art-nebula"></div>
        <div class="showcase-card-caption">
          <span class="caption-label mono-text">Nebula / Shuffled</span>
          <span class="caption-hint">Hilbert curve</span>
        </div>
      </div>
      <div class="showcase-card reveal-element" role="img" aria-label="Crystalline formation with sharp angular structures">
        <div class="art-placeholder art-crystal"></div>
        <div class="showcase-card-caption">
          <span class="caption-label mono-text">Crystal / Base Distance</span>
          <span class="caption-hint">Morton Z-order</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section" aria-labelledby="features-title">
    <div class="features-header reveal-element">
      <p class="mono-text features-eyebrow">Capabilities</p>
      <h2 id="features-title" class="features-title">Designed for exploration</h2>
    </div>
    <div class="features-grid">
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3 class="feature-card-title">Deterministic Output</h3>
        <p class="feature-card-text">
          Same settings always produce the same image. Treat every run as a reproducible study.
        </p>
      </article>
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </div>
        <h3 class="feature-card-title">Space-Filling Curves</h3>
        <p class="feature-card-text">
          Choose Hilbert or Morton traversal to control how the canvas is visited and how color flows.
        </p>
      </article>
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3 class="feature-card-title">Symmetry Rules</h3>
        <p class="feature-card-text">
          None, bilateral, quadrantal, or radial symmetry. Each rule reshapes the same seed into a new composition.
        </p>
      </article>
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>
        <h3 class="feature-card-title">High-Res Export</h3>
        <p class="feature-card-text">
          Export finished compositions as PNG or PDF. Ready for print, presentation, or portfolio use.
        </p>
      </article>
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3 class="feature-card-title">Saved Gallery</h3>
        <p class="feature-card-text">
          Bookmark the strongest studies. Return later to compare, refine, or export without losing the exact settings.
        </p>
      </article>
      <article class="feature-card reveal-element">
        <div class="feature-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <h3 class="feature-card-title">Live Preview</h3>
        <p class="feature-card-text">
          Adjust controls and watch the canvas update in real time. Experiment quickly, decide with confidence.
        </p>
      </article>
    </div>
  </section>

  <!-- Studio Notes -->
  <section class="notes-section reveal-element" aria-labelledby="notes-title">
    <details class="art-index-copy">
      <summary id="notes-title">Studio notes</summary>
      <p>
        The studio is designed for deliberate exploration rather than random
        effects. Use the controls to compare Hilbert and Morton traversal,
        change how color moves through the image, then save the strongest
        variations into the gallery for later review.
      </p>
      <p>
        A seed defines the starting point, a traversal curve determines how the
        canvas is visited, and color rules decide how structure becomes visible.
        Adjust one setting at a time when you want to compare related outputs.
      </p>
      <p>
        Small parameter changes often explain the system better than a completely
        new random seed. Compare related runs when you want to understand how a
        pattern forms, then keep the saved versions that show a clear difference
        in density, symmetry, or color rhythm.
      </p>
      <p>
        The generator is useful as a sketchbook, a reference archive, and a way to
        make algorithmic rules visible. The final image matters, but the settings
        behind it matter too because they let the same result be recreated later.
      </p>
      <p>
        When a run works, save it before changing controls. Comparing saved outputs
        against the active canvas makes it easier to spot which choice actually
        improved the artwork: the curve, the symmetry, the seed, or the color path.
      </p>
      <p>
        The tool is intentionally focused on repeatable visual systems, so each
        experiment can become either a finished composition or a note about how a
        particular rule behaves.
      </p>
    </details>
  </section>

  <!-- Generator -->
  <section id="generator" class="generator-wrapper reveal-element">
    <!-- Minimalist Brutal Loader -->
    <div class="art-loader" id="art-loader">
      <div class="loader-container">
        <div class="brutal-spinner"></div>
        <div class="loader-text mono-text">[INITIALIZING SYSTEM]</div>
        <div class="loader-subtext mono-text">Loading generative engine...</div>
      </div>
    </div>
    <div class="generator-container">
      <GenerationPage client:only="react" />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Hide loader when React component loads
  const checkReactLoaded = () => {
    const loader = document.getElementById("art-loader");
    const generator = document.querySelector(".generator-container");
    if (generator && generator.children.length > 0) {
      if (loader) {
        loader.classList.add("fade-out");
        setTimeout(() => {
          loader.style.display = "none";
        }, 500);
      }
    } else {
      requestAnimationFrame(checkReactLoaded);
    }
  };
  // Start checking after a brief delay
  setTimeout(checkReactLoaded, 100);
</script>

<style>
  /* ========================================
     HERO
     ======================================== */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    box-sizing: border-box;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-paper);
  }

  .mesh-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(85,103,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(85,103,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 1;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
    animation: blobFloat 20s ease-in-out infinite;
    z-index: 0;
  }

  .blob-1 {
    width: 50vw;
    height: 50vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle at 30% 30%, var(--color-accent), transparent 70%);
    top: -10%;
    left: -10%;
    animation-delay: 0s;
  }

  .blob-2 {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    background: radial-gradient(circle at 50% 50%, #7c3aed, transparent 70%);
    bottom: -5%;
    right: -5%;
    animation-delay: -5s;
    opacity: 0.3;
  }

  .blob-3 {
    width: 35vw;
    height: 35vw;
    max-width: 420px;
    max-height: 420px;
    background: radial-gradient(circle at 60% 40%, #ec4899, transparent 70%);
    top: 30%;
    right: 15%;
    animation-delay: -10s;
    opacity: 0.25;
  }

  .blob-4 {
    width: 30vw;
    height: 30vw;
    max-width: 360px;
    max-height: 360px;
    background: radial-gradient(circle at 40% 60%, #06b6d4, transparent 70%);
    bottom: 20%;
    left: 10%;
    animation-delay: -15s;
    opacity: 0.2;
  }

  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -20px) scale(1.05); }
    50% { transform: translate(-20px, 30px) scale(0.95); }
    75% { transform: translate(20px, 20px) scale(1.02); }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(900px, 100%);
    text-align: center;
  }

  .hero-eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-ink);
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }

  .hero-meta {
    color: var(--color-ink-light);
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .hero-lead {
    max-width: 60ch;
    margin: 0 auto 2rem;
    color: var(--color-ink-light);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.85rem 1.5rem;
    border: var(--border-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cta-primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 4px 4px 0 0 var(--color-accent);
  }

  .cta-primary:hover {
    background: var(--color-accent);
    color: var(--color-paper);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--color-ink);
  }

  .cta-secondary {
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 4px 4px 0 0 var(--color-ink);
  }

  .cta-secondary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--color-accent);
  }

  /* ========================================
     SHOWCASE
     ======================================== */
  .showcase-section {
    width: min(1240px, calc(100% - 2rem));
    margin: 4rem auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .showcase-eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .showcase-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 3rem);
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .showcase-desc {
    max-width: 55ch;
    margin: 0 auto;
    color: var(--color-ink-light);
    line-height: 1.7;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .showcase-card {
    background: var(--color-paper-alt);
    border: var(--border-ink);
    box-shadow: 6px 6px 0 0 var(--color-ink);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .showcase-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 0 var(--color-accent);
  }

  .art-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
  }

  .art-radial {
    background:
      repeating-conic-gradient(from 0deg at 50% 50%,
        hsl(250, 80%, 60%) 0deg 15deg,
        hsl(280, 70%, 55%) 15deg 30deg,
        hsl(320, 60%, 50%) 30deg 45deg,
        hsl(10, 70%, 55%) 45deg 60deg,
        hsl(40, 80%, 60%) 60deg 75deg,
        hsl(170, 70%, 55%) 75deg 90deg
      );
    opacity: 0.85;
  }

  .art-radial::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 20%, var(--color-paper-alt) 70%);
  }

  .art-quadrant {
    background:
      conic-gradient(from 0deg at 50% 50%,
        #5567ff 0deg 90deg,
        #7c3aed 90deg 180deg,
        #ec4899 180deg 270deg,
        #06b6d4 270deg 360deg
      );
  }

  .art-quadrant::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, transparent 48%, rgba(27,34,52,0.15) 49%, rgba(27,34,52,0.15) 51%, transparent 52%),
      linear-gradient(-45deg, transparent 48%, rgba(27,34,52,0.15) 49%, rgba(27,34,52,0.15) 51%, transparent 52%);
    background-size: 24px 24px;
  }

  .art-nebula {
    background:
      radial-gradient(circle at 30% 30%, rgba(85,103,255,0.6) 0%, transparent 50%),
      radial-gradient(circle at 70% 60%, rgba(236,72,153,0.5) 0%, transparent 50%),
      radial-gradient(circle at 50% 80%, rgba(6,182,212,0.5) 0%, transparent 50%),
      radial-gradient(circle at 20% 70%, rgba(124,58,237,0.4) 0%, transparent 50%);
    filter: blur(1px);
  }

  .art-crystal {
    background:
      linear-gradient(135deg, #1b2234 0%, #465069 50%, #1b2234 100%);
  }

  .art-crystal::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(30deg, transparent 40%, rgba(85,103,255,0.3) 45%, rgba(85,103,255,0.3) 55%, transparent 60%),
      linear-gradient(150deg, transparent 40%, rgba(236,72,153,0.25) 45%, rgba(236,72,153,0.25) 55%, transparent 60%),
      linear-gradient(90deg, transparent 40%, rgba(6,182,212,0.2) 45%, rgba(6,182,212,0.2) 55%, transparent 60%);
    background-size: 40px 40px;
  }

  .showcase-card-caption {
    padding: 1rem;
    border-top: var(--border-ink);
    background: var(--color-paper);
  }

  .caption-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .caption-hint {
    display: block;
    font-size: 0.8rem;
    color: var(--color-ink-light);
  }

  /* ========================================
     FEATURES
     ======================================== */
  .features-section {
    width: min(1120px, calc(100% - 2rem));
    margin: 5rem auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .features-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .features-eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .features-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 3rem);
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .feature-card {
    background: var(--color-paper-alt);
    border: var(--border-ink);
    padding: 1.75rem;
    box-shadow: 6px 6px 0 0 var(--color-ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 0 var(--color-accent);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-ink);
    background: var(--color-paper);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .feature-card-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .feature-card-text {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-ink-light);
    margin: 0;
  }

  /* ========================================
     STUDIO NOTES
     ======================================== */
  .notes-section {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto 3rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .art-index-copy {
    border: var(--border-ink);
    background: var(--color-paper-alt);
    box-shadow: 8px 8px 0 0 var(--color-ink);
    color: var(--color-ink);
  }

  .art-index-copy summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    list-style-position: inside;
    padding: 0.75rem 1rem;
    text-transform: uppercase;
  }

  .art-index-copy summary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .art-index-copy p {
    margin: 0;
    padding: 0 1rem 1rem;
    max-width: 72ch;
    line-height: 1.7;
    color: var(--color-ink-light);
  }

  /* ========================================
     GENERATOR & LOADER
     ======================================== */
  .generator-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    margin-bottom: 3rem;
  }

  .generator-container {
    width: 100%;
    max-width: 1240px;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .art-loader {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    background: var(--color-paper);
    opacity: 1;
    transition: opacity 0.4s cubic-bezier(0.2, 0, 0, 1);
  }

  .art-loader.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .loader-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    background: var(--color-paper-alt);
    padding: 2.5rem 5rem;
    border: var(--border-ink);
    box-shadow: 12px 12px 0 0 var(--color-ink);
  }

  .brutal-spinner {
    width: 44px;
    height: 44px;
    border: 4px solid var(--color-ink);
    border-right-color: transparent;
    animation: spin 0.8s linear infinite;
  }

  .loader-text {
    color: var(--color-ink);
    font-weight: 600;
    animation: blink 1.2s step-end infinite;
  }

  .loader-subtext {
    color: var(--color-ink-light);
    font-size: 0.75rem;
    animation: blink 1.2s step-end infinite;
    animation-delay: 0.3s;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
